# Database
DATABASE_URL=postgresql://user:password@localhost:5432/goi_y_mon_hoc

# AI APIs (ưu tiên theo thứ tự: Gemini → OpenAI → Claude)
GEMINI_API_KEY=your_gemini_api_key_here      # Free — https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash                # Hoặc gemini-1.5-flash

OPENAI_API_KEY=                              # Tùy chọn
OPENAI_MODEL=gpt-4o-mini                     # Tùy chọn

ANTHROPIC_API_KEY=                           # Tùy chọn

# Google OAuth (tùy chọn — bỏ trống nếu không dùng đăng nhập Google)
# Lấy tại: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Admin registration secret — đặt chuỗi bí mật để bảo vệ API tạo tài khoản admin
ADMIN_SECRET=change_me_before_deploying

# CORS — danh sách origin được phép, phân cách bởi dấu phẩy
# Mặc định: localhost. Production: đặt đúng domain của bạn
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
