async function _ensureUsersLoaded() {
  if (_allUsers && _allUsers.length) return;
  if (_allStudentsForAssign && _allStudentsForAssign.length) {
    _allUsers = _allStudentsForAssign;
    return;
  }
  const res = await callApi('/admin/users', { headers: auth() });
