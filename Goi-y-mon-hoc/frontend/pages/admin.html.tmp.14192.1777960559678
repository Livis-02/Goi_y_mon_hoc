  const _SPEC_LABEL = {
    '7480201_07': 'KHMT', '7480201_06': 'MMT', '7480201_05': 'CNPM',
    '7480201_09': 'HTTT', '7480201_04': 'THKT', '7480201_08': 'CNTTDH', '': 'Đại cương'
  };

  let html = `<div class="bg-green-50 border border-green-200 rounded-xl p-3 text-sm font-semibold text-green-700 mb-3">${escHtml(message)}</div>`;

