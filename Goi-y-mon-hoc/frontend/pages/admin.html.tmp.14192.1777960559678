// Section collapse state — Set chứa các spec key đang đóng.
// Default: TẤT CẢ ĐÓNG khi vào lần đầu (chưa có localStorage). User click expand
// thì lưu state. Các session sau khôi phục state đã lưu.
const _ADV_SECTIONS_KEY = '_advSectionsCollapsed';
const _advSectionsCollapsed = (() => {
  try {
    const s = localStorage.getItem(_ADV_SECTIONS_KEY);
    if (s !== null) {
      // Đã có state lưu trước đó → khôi phục
      return new Set(JSON.parse(s));
    }
  } catch (_) {}
  // Lần đầu vào — chưa có state lưu → mặc định ĐÓNG TẤT CẢ.
  // _populateInitialCollapse() sẽ fill các spec key sau khi load advisors.
  return new Set();
})();

let _advSectionsInitialized = false;

function _populateInitialCollapse(allSpecKeys) {
  // Chỉ chạy 1 lần đầu khi chưa có state localStorage — đóng hết các section.
  if (_advSectionsInitialized) return;
  _advSectionsInitialized = true;
  try {
    if (localStorage.getItem(_ADV_SECTIONS_KEY) !== null) return;  // đã có state → tôn trọng
  } catch (_) {}
  for (const k of allSpecKeys) _advSectionsCollapsed.add(k);
  _persistSectionState();
}

function _persistSectionState() {
  try { localStorage.setItem(_ADV_SECTIONS_KEY, JSON.stringify([..._advSectionsCollapsed])); } catch (_) {}
}

function _toggleAdvSection(specKey) {
  const body = document.getElementById(`adv-sec-body-${specKey || '_'}`);
  const chev = document.getElementById(`adv-sec-chev-${specKey || '_'}`);
  if (!body) return;
  if (_advSectionsCollapsed.has(specKey)) {
    _advSectionsCollapsed.delete(specKey);
    body.classList.remove('hidden');
    chev?.classList.remove('-rotate-90');
  } else {
    _advSectionsCollapsed.add(specKey);
    body.classList.add('hidden');
    chev?.classList.add('-rotate-90');
  }
  _persistSectionState();
}

function _advExpandAll(open) {
  const allKeys = new Set();
  for (const a of _advisorsList) allKeys.add(a.managed_specialization || '');
  if (open) {
    _advSectionsCollapsed.clear();
  } else {
    _advSectionsCollapsed.clear();
    for (const k of allKeys) _advSectionsCollapsed.add(k);
  }
  _persistSectionState();
