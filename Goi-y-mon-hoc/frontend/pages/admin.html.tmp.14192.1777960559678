async function submitBulkAssignList() {
  if (!_activeAdvisorId) return;
  const resultEl = document.getElementById('importAssignResult');
  const isFileMode = !document.getElementById('assignBulkFilePane').classList.contains('hidden');
  let usernames = [];

  if (isFileMode) {
    const fileInput = document.getElementById('importAssignFile');
    if (!fileInput.files.length) { toast('Chọn file trước'); return; }
    const text = await fileInput.files[0].text();
    usernames = text.split(/\r?\n/).map(s => s.trim().replace(/^["']|["']$/g, '')).filter(Boolean);
    if (usernames[0]?.toLowerCase() === 'username') usernames.shift();
  } else {
    const text = document.getElementById('importAssignText').value;
    usernames = text.split(/\r?\n/).map(s => s.trim()).filter(Boolean);
  }

  if (!usernames.length) { toast('Không có username nào'); return; }
  resultEl.innerHTML = '<p class="text-sm text-text-tertiary text-center py-2"><span class="spin material-symbols-outlined text-base">progress_activity</span></p>';

  const res = await callApi(`/admin/advisors/${_activeAdvisorId}/assign/bulk`, {
    method: 'POST',
    headers: { ...auth(), 'Content-Type': 'application/json' },
    body: JSON.stringify({ student_usernames: usernames }),
  });

  if (!res.ok) {
    resultEl.innerHTML = `<p class="text-sm text-danger text-center py-2">${escHtml(res.data?.detail || 'Lỗi phân công')}</p>`;
    return;
  }

  const { assigned_count, skipped_count, errors } = res.data;
  let html = `<div class="bg-green-50 border border-green-200 rounded-xl p-3 text-sm">
    <p class="font-semibold text-green-700">Đã phân công ${assigned_count} sinh viên${skipped_count ? `, bỏ qua ${skipped_count} (đã phân công)` : ''}</p>
  </div>`;
  if (errors.length) {
    html += `<div class="bg-danger-soft border border-danger rounded-xl p-3 mt-2 text-xs text-danger max-h-24 overflow-y-auto">
      ${errors.map(e => `<p>${escHtml(e)}</p>`).join('')}
    </div>`;
  }
  resultEl.innerHTML = html;
  loadCurrentAssignments(_activeAdvisorId);
  loadAdvisorsList();
}

async function loadCurrentAssignments(advisorId) {
  const el = document.getElementById('assignModalCurrentList');
  if (!el) return;
  el.innerHTML = '<p class="text-sm text-text-tertiary py-2 text-center"><span class="spin material-symbols-outlined text-base">progress_activity</span></p>';
  const res = await callApi(`/admin/advisors/${advisorId}/students`, { headers: auth() });
  if (!res.ok) { el.innerHTML = '<p class="text-sm text-red-400 text-center py-2">Lỗi tải danh sách.</p>'; return; }
  const list = res.data || [];
  if (!list.length) {
    el.innerHTML = '<p class="text-sm text-text-tertiary py-3 text-center">Chưa có sinh viên nào.</p>';
    return;
  }
  el.innerHTML = list.map(a => `
    <div class="flex items-center gap-3 px-3 py-2 bg-surface-subtle rounded-xl">
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium truncate">${escHtml(a.full_name || a.username)}</p>
        <p class="text-xs text-text-tertiary">${escHtml(a.username)}</p>
      </div>
      <button onclick="unassignStudent(${advisorId}, ${a.student_id})"
        class="flex-shrink-0 p-1.5 rounded-lg hover:bg-danger-soft hover:text-danger text-text-tertiary transition-colors" title="Hủy phân công">
        <span class="material-symbols-outlined text-sm">person_remove</span>
      </button>
    </div>`).join('');
}

async function assignStudent() {
  if (!_activeAdvisorId) return;
  const studentId = parseInt(document.getElementById('assignModalStudentSel').value);
  if (!studentId) { toast('Vui lòng chọn sinh viên'); return; }
  const res = await callApi(`/admin/advisors/${_activeAdvisorId}/assign`, {
    method: 'POST', headers: { ...auth(), 'Content-Type': 'application/json' },
    body: JSON.stringify({ student_id: studentId }),
  });
  if (res.ok) {
    toast(res.data.message || 'Đã phân công');
    document.getElementById('assignModalStudentSel').value = '';
    loadCurrentAssignments(_activeAdvisorId);
    loadAdvisorsList();
  } else {
    toast(res.data?.detail || 'Lỗi phân công', false);
  }
}

function unassignStudent(advisorId, studentId) {
  _confirm('Hủy phân công sinh viên này?', async () => {
    const res = await callApi(`/admin/advisors/${advisorId}/assign/${studentId}`, {
      method: 'DELETE', headers: auth(),
    });
    if (res.ok) {
      toast('Đã hủy phân công');
      loadCurrentAssignments(advisorId);
      loadAdvisorsList();
    } else {
      toast(res.data?.detail || 'Lỗi hủy phân công', false);
    }
  });
}
</script>


