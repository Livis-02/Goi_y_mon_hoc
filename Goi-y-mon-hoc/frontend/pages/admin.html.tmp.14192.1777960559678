async function viewUserGrades(userId, name) {
  const modal = document.getElementById('modalGradesView');
  document.getElementById('gradesModalTitle').textContent = `Bảng điểm: ${name}`;
  document.getElementById('gradesModalSub').textContent = '';
  document.getElementById('gradesModalBody').innerHTML = '<p class="text-text-tertiary text-sm">Đang tải...</p>';
  modal.classList.remove('hidden');
  modal.classList.add('flex');

  const res = await callApi(`/admin/users/${userId}/grades`, { headers: auth() });
  if (!res.ok || !res.data.length) {
    document.getElementById('gradesModalBody').innerHTML = '<p class="text-text-tertiary text-sm py-8 text-center">Chưa có dữ liệu điểm.</p>';
    return;
  }

  // Group by term
  const byTerm = {};
  for (const g of res.data) {
    const t = g.term || 'Chưa rõ học kỳ';
    if (!byTerm[t]) byTerm[t] = [];
    byTerm[t].push(g);
  }

  // Tổng hợp
  const allPassed = res.data.filter(g => g.passed);
  const totalTC = allPassed.reduce((s, g) => s + (g.credits || 0), 0);
  const counted = allPassed.filter(g => g.score4 != null && g.score4 > 0);
  const gpa4 = counted.length
    ? (counted.reduce((s, g) => s + g.score4 * (g.credits || 0), 0) / counted.reduce((s, g) => s + (g.credits || 0), 0)).toFixed(2)
    : '—';

  document.getElementById('gradesModalSub').textContent = `${res.data.length} môn · TC tích lũy: ${totalTC} · GPA4: ${gpa4}`;

  let html = '';
  for (const [term, grades] of Object.entries(byTerm)) {
    html += `<div class="mb-5">
      <h4 class="text-xs font-bold text-text-tertiary uppercase tracking-wider mb-2 px-1">${term}</h4>
      <table class="w-full text-xs rounded-lg overflow-hidden">
        <thead><tr class="bg-surface-subtle text-text-secondary">
          <th class="px-3 py-2 text-left font-semibold">Mã môn</th>
          <th class="px-3 py-2 text-left font-semibold">Tên môn</th>
          <th class="px-3 py-2 text-center font-semibold">TC</th>
          <th class="px-3 py-2 text-center font-semibold">Điểm 10</th>
