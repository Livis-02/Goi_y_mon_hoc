async function bgProcessAll() {
  const btn = document.getElementById('bgProcessAllBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="material-symbols-outlined spin text-base">progress_activity</span> Đang xử lý...';

  const totalFiles = _bgFiles.filter(Boolean).length;
  _bgResults = new Array(_bgFiles.length);
  let _bgDone = 0;

  // Switch to Phase 3 immediately so the progress counter is visible
  _bgShowPhase(3);
  document.getElementById('bgResultSummary').textContent = `Đang xử lý 0 / ${totalFiles} file...`;
  document.getElementById('bgResultBody').innerHTML = '';
  document.getElementById('bgPwActions').classList.add('hidden');
  document.getElementById('bgPwConfirmBox').classList.add('hidden');
  document.getElementById('bgRetryAllBox').classList.add('hidden');
  document.getElementById('bgCloseBtn').disabled = true;
  const counterEl = document.getElementById('bgProgressCounter');
  counterEl.textContent = `Đã xử lý 0 / ${totalFiles} file`;
  counterEl.classList.remove('hidden');

  // Process — max 5 concurrent to avoid overloading backend
  await _bgRunThrottled(_bgFiles, async (file, i) => {
    if (!file) return null;
    const result = await _bgImportFile(file, i);
    _bgResults[i] = result;
    _bgDone++;
    // Live-update counter and summary banner
    counterEl.textContent = `Đã xử lý ${_bgDone} / ${totalFiles} file`;
    document.getElementById('bgResultSummary').textContent =
      `Đang xử lý ${_bgDone} / ${totalFiles} file...`;
    // Append result row immediately
    document.getElementById('bgResultBody').insertAdjacentHTML('beforeend', _bgResultRow(result, i));
    return result;
  }, 5);
  _bgResults = _bgResults.filter(r => r !== undefined && r !== null);

  // Finalize — update summary banner, password bar, retry button
  const ok     = _bgResults.filter(r => r.ok).length;
  const failed = _bgResults.length - ok;
  document.getElementById('bgResultSummary').textContent =
    `Đã xử lý ${_bgResults.length} file — ${ok} thành công${failed ? ', ' + failed + ' thất bại' : ''}`;
  counterEl.textContent = `Đã xử lý ${_bgResults.length} / ${totalFiles} file`;

  // Password bar
  const newPws = _bgGetPasswordRows();
  if (newPws.length) {
    const pwCount = document.getElementById('bgPwCount');
    if (pwCount) pwCount.textContent = `${newPws.length} mật khẩu`;
    document.getElementById('bgPwActions').classList.remove('hidden');
    document.getElementById('bgPwConfirmBox').classList.remove('hidden');
    const cb = document.getElementById('bgPwAcked');
    if (cb) cb.checked = false;
    document.getElementById('bgCloseBtn').disabled = true;
  } else {
    document.getElementById('bgCloseBtn').disabled = false;
  }
  const retryBox2 = document.getElementById('bgRetryAllBox');
  const failCountEl2 = document.getElementById('bgFailCount');
  if (retryBox2) retryBox2.classList.toggle('hidden', failed === 0);
  if (failCountEl2 && failed > 0) failCountEl2.textContent = `${failed} file thất bại`;

  // Toast cho các SV phát hiện được CN mới
  for (const r of _bgResults) {
    if (r.ok && r.data?.specialization_changed && r.data?.new_specialization) {
      toast(`✅ SV ${r.data.student_code} → CN: ${r.data.new_specialization}`);
    }
  }

  // Refresh danh sách SV
  loadUsersTab();
}

async function _bgImportFile(file, idx) {
  const fd = new FormData();
  fd.append('file', file);
  try {
    const res = await fetch(`${API_BASE}/admin/grades/import`, {
      method: 'POST', headers: { Authorization: `Bearer ${token}` }, body: fd,
    });
    const data = await res.json();
    return { file_name: file.name, ok: res.ok, data };
  } catch(e) {
    return { file_name: file.name, ok: false, data: { detail: 'Lỗi kết nối: ' + e.message } };
  }
}

function _bgUpdateCardResult(cardEl, result) {
  const statusIcon = result.ok
    ? '<span class="material-symbols-outlined text-success text-base" style="font-variation-settings:\'FILL\' 1">check_circle</span>'
    : '<span class="material-symbols-outlined text-danger text-base" style="font-variation-settings:\'FILL\' 1">error</span>';
  const hdrDiv = cardEl.querySelector('div:first-child');
  if (hdrDiv) {
    // Remove spinner
    hdrDiv.querySelectorAll('.spin').forEach(s => s.remove());
    hdrDiv.insertAdjacentHTML('beforeend', statusIcon);
  }
}

function _bgResultRow(r, resultIdx) {
  if (r.ok) {
    const d = r.data;
    const status = d.account_created
      ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 bg-success-soft text-success text-xs font-bold rounded-full">Tạo mới</span>'
      : '<span class="inline-flex items-center gap-1 px-2 py-0.5 bg-accent-soft text-indigo-700 text-xs font-bold rounded-full">Cập nhật</span>';
    const pw = d.password_plain
      ? `<span class="font-mono text-sm font-bold text-warning bg-warning-soft px-2 py-0.5 rounded select-all">${escHtml(d.password_plain)}</span>`
      : '<span class="text-text-tertiary text-xs">—</span>';
    const specCell = d.specialization_changed && d.new_specialization
      ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 bg-accent-soft text-violet-700 text-xs font-bold rounded-full">✨ ${escHtml(d.new_specialization)}</span>`
      : '<span class="text-text-tertiary text-xs">—</span>';
    return `<tr id="bgRow${resultIdx}" class="hover:bg-surface-subtle">
      <td class="px-4 py-3 text-xs text-text-tertiary truncate max-w-[160px]">${escHtml(r.file_name)}</td>
      <td class="px-4 py-3 font-mono font-bold text-sm">${escHtml(d.student_code || '—')}</td>
      <td class="px-4 py-3 text-center font-bold text-success">${d.grades_imported}</td>
      <td class="px-4 py-3 text-center">${status}</td>
      <td class="px-4 py-3">${pw}</td>
      <td class="px-4 py-3">${specCell}</td>
      <td class="px-4 py-3 text-xs text-text-tertiary">
        ${d.advisor_assigned
          ? escHtml(d.advisor_assigned.full_name || d.advisor_assigned.id || '—')
          : d.advisor_warning
            ? `<span class="text-warning" title="${escHtml(d.advisor_warning)}">⚠️ Chưa có trưởng</span>`
            : '—'}
      </td>
      <td class="px-4 py-3 text-center">—</td>
    </tr>`;
  } else if (r.retrying) {
    return `<tr id="bgRow${resultIdx}" class="bg-accent-soft/50">
      <td class="px-4 py-3 text-xs text-text-tertiary truncate max-w-[160px]">${escHtml(r.file_name)}</td>
      <td colspan="6" class="px-4 py-3 text-xs text-accent">Đang xử lý lại…</td>
      <td class="px-4 py-3 text-center">
        <span class="material-symbols-outlined spin text-accent text-base">progress_activity</span>
      </td>
    </tr>`;
  } else {
    return `<tr id="bgRow${resultIdx}" class="bg-danger-soft/50">
      <td class="px-4 py-3 text-xs text-text-tertiary truncate max-w-[160px]">${escHtml(r.file_name)}</td>
      <td colspan="6" class="px-4 py-3 text-xs text-danger">${escHtml(r.data?.detail || 'Lỗi không xác định')}</td>
      <td class="px-4 py-3 text-center">
        <button onclick="_bgRetryFile(${resultIdx})" class="flex items-center gap-1 px-2 py-1 bg-[#1a146b] text-white rounded text-xs font-bold hover:bg-[#312e81]">
          <span class="material-symbols-outlined text-sm">refresh</span>Thử lại
        </button>
      </td>
    </tr>`;
  }
}

function _bgShowResults() {
  _bgShowPhase(3);
  const ok    = _bgResults.filter(r => r.ok).length;
  const total = _bgResults.length;
  const failed = total - ok;
  document.getElementById('bgResultSummary').textContent =
    `Đã xử lý ${total} file — ${ok} thành công${failed ? ', ' + failed + ' thất bại' : ''}`;

  const counterEl = document.getElementById('bgProgressCounter');
  if (counterEl) { counterEl.textContent = `Đã xử lý ${total} / ${total} file`; counterEl.classList.remove('hidden'); }

  document.getElementById('bgResultBody').innerHTML = _bgResults.map((r, i) => _bgResultRow(r, i)).join('');

  // Password bar — show only if any new passwords exist
  const pwRows = _bgGetPasswordRows();
  const pwActions = document.getElementById('bgPwActions');
  const pwConfirm = document.getElementById('bgPwConfirmBox');
  const pwCount = document.getElementById('bgPwCount');
  if (pwRows.length > 0) {
    if (pwCount) pwCount.textContent = `${pwRows.length} mật khẩu`;
    pwActions?.classList.remove('hidden');
    pwConfirm?.classList.remove('hidden');
    const cb = document.getElementById('bgPwAcked');
    if (cb) cb.checked = false;
    const closeBtn = document.getElementById('bgCloseBtn');
    if (closeBtn) closeBtn.disabled = true;
  } else {
    pwActions?.classList.add('hidden');
    pwConfirm?.classList.add('hidden');
    const closeBtn = document.getElementById('bgCloseBtn');
    if (closeBtn) closeBtn.disabled = false;
  }

  // Retry-all box
  const retryBox = document.getElementById('bgRetryAllBox');
  const failCountEl = document.getElementById('bgFailCount');
  if (retryBox) retryBox.classList.toggle('hidden', failed === 0);
  if (failCountEl && failed > 0) failCountEl.textContent = `${failed} file thất bại`;
}

function _bgGetPasswordRows() {
  return _bgResults
    .filter(r => r && r.ok && r.data?.password_plain)
    .map(r => ({
      student_code: r.data.student_code || '',
      full_name: r.data.full_name || '',
      password: r.data.password_plain,
    }));
}

function _bgOnPwAckChange() {
  const ack = document.getElementById('bgPwAcked').checked;
  const closeBtn = document.getElementById('bgCloseBtn');
  if (closeBtn) closeBtn.disabled = !ack;
}

function _bgCopyAllPasswords() {
  const rows = _bgGetPasswordRows();
  if (!rows.length) { toast('Không có mật khẩu nào để copy', false); return; }
  const txt = rows.map(r => `${r.student_code}\t${r.full_name}\t${r.password}`).join('\n');
  navigator.clipboard.writeText(txt)
    .then(() => toast(`Đã copy ${rows.length} mật khẩu vào clipboard`))
    .catch(() => toast('Không copy được', false));
}

function _bgExportPasswordsCsv() {
  const rows = _bgGetPasswordRows();
  if (!rows.length) { toast('Không có mật khẩu nào để xuất', false); return; }
  const BOM = '﻿';
  const header = 'Mã SV,Họ tên,Mật khẩu\n';
  const body = rows.map(r =>
    `"${r.student_code}","${r.full_name.replace(/"/g, '""')}","${r.password}"`
  ).join('\n');
  const blob = new Blob([BOM + header + body], { type: 'text/csv;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const ts = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
  const a = document.createElement('a');
  a.href = url; a.download = `mat_khau_${ts}.csv`;
  document.body.appendChild(a); a.click();
  document.body.removeChild(a); URL.revokeObjectURL(url);
  toast(`Đã xuất ${rows.length} mật khẩu`);
}



async function _bgRetryFile(idx) {
  const r = _bgResults[idx];
  if (!r || r.ok) return;
  const file = _bgFiles[idx];
  if (!file) { toast('Không tìm thấy file để retry', false); return; }
  toast(`Đang thử lại: ${file.name}`);
  _bgResults[idx] = { file_name: file.name, ok: false, data: { detail: 'Đang xử lý...' }, retrying: true };
  _bgShowResults();
  const result = await _bgImportFile(file, idx);
  _bgResults[idx] = result;
  _bgShowResults();
  if (result.ok) toast(`✓ Thử lại thành công: ${file.name}`);
  else toast(`✗ Vẫn lỗi: ${result.data?.detail || 'Không rõ'}`, false);
}

function _bgRetryAllFailed() {
  const failedIndexes = _bgResults.map((r, i) => ({ r, i })).filter(x => x.r && !x.r.ok && !x.r.retrying).map(x => x.i);
  if (!failedIndexes.length) { toast('Không có file lỗi để retry'); return; }
  _confirm(`Thử lại ${failedIndexes.length} file lỗi?`, async () => {
    toast(`Đang thử lại ${failedIndexes.length} file...`);
    failedIndexes.forEach(i => {
      const f = _bgFiles[i];
      _bgResults[i] = { file_name: f?.name || '', ok: false, data: { detail: 'Đang xử lý...' }, retrying: true };
    });
    _bgShowResults();
    const items = failedIndexes.filter(i => _bgFiles[i]);
    await _bgRunThrottled(items, async (i) => {
      const result = await _bgImportFile(_bgFiles[i], i);
      _bgResults[i] = result;
    }, 5);
    _bgShowResults();
    const okCount = failedIndexes.filter(i => _bgResults[i]?.ok).length;
    toast(`Xong retry: ${okCount}/${failedIndexes.length} thành công`);
  }, 'Thử lại');
}

function bgCopyResults() {
  const rows = _bgResults.map(r => {
    if (r.ok) {
      const d = r.data;
      return [r.file_name, d.student_code, d.grades_imported, d.account_created ? 'Tạo mới' : 'Cập nhật', d.password_plain || '', d.new_specialization || '', d.advisor_assigned || ''].join('\t');
    }
    return [r.file_name, 'LỖI', '', '', '', '', r.data?.detail || ''].join('\t');
  });
  const header = 'Tên file\tMã SV\tMôn import\tTrạng thái\tMật khẩu\tChuyên ngành\tCố vấn';
  navigator.clipboard.writeText([header, ...rows].join('\n'))
    .then(() => toast('Đã copy bảng kết quả'))
    .catch(() => toast('Không thể copy', false));
}
</script>

