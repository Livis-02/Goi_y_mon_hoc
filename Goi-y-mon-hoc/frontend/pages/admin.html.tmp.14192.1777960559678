function _crsLookupCourseByCode(code) {
  for (const data of Object.values(_crsDataCache || {})) {
    if (!data) continue;
    for (const arr of [data.compulsory, data.elective_a?.courses, data.elective_b?.courses, data.elective_c?.courses]) {
      const found = (arr || []).find(c => c.course_code === code);
      if (found) return found;
    }
  }
  return null;
}

function _renderSkillsModal(allSkills) {
  // Group by category
  const byCat = {};
  allSkills.forEach(s => {
    (byCat[s.category] = byCat[s.category] || []).push(s);
  });

  const html = Object.entries(byCat).map(([cat, skills]) => {
    const catLabel = _SKILL_CAT_LABEL[cat] || cat;
    const catColor = _SKILL_CAT_COLOR[cat] || _SKILL_CAT_COLOR.other;
    return `<div>
      <p class="text-[10px] font-bold uppercase tracking-wider text-text-tertiary mb-1.5">${catLabel}</p>
      <div class="flex flex-wrap gap-1.5">
        ${skills.map(s => {
          const checked = s.code in _skillsSelected;
          const weight = _skillsSelected[s.code] || 1.0;
          return `<label class="inline-flex items-center gap-1.5 px-2 py-1 rounded border cursor-pointer transition-all ${checked ? catColor.replace('-50', '-100') + ' border-2' : 'bg-surface border-border-default hover:bg-surface-subtle'}">
            <input type="checkbox" ${checked ? 'checked' : ''}
              onchange="_toggleSkill('${s.code}', this.checked)"
              class="accent-violet-600 w-3.5 h-3.5"/>
            <span class="text-xs font-medium">${escHtml(s.name)}</span>
            ${checked ? `<input type="range" min="0.3" max="1" step="0.1" value="${weight}"
              oninput="_updateSkillWeight('${s.code}', this.value); this.nextElementSibling.textContent=parseFloat(this.value).toFixed(1);"
              onclick="event.stopPropagation()"
              class="w-14 h-1 ml-1 accent-violet-600"/>
              <span class="text-[10px] text-accent font-bold w-6">${weight.toFixed(1)}</span>` : ''}
          </label>`;
        }).join('')}
      </div>
    </div>`;
  }).join('');

  document.getElementById('crsSkillsContent').innerHTML = html || '<p class="text-sm text-text-tertiary">Chưa có skill nào trong hệ thống.</p>';
  _updateSkillsCount();
}

function _toggleSkill(code, checked) {
  if (checked) {
    _skillsSelected[code] = 1.0;
