function renderSvPagination(total, pageSize, totalPages) {
  const bar = document.getElementById('svPagination');
  const ctrl = document.getElementById('svPageControls');
  if (!bar || !ctrl) return;
  bar.classList.toggle('hidden', totalPages <= 1);
  if (totalPages <= 1) return;

  const btnCls = (active) => active
    ? 'px-2.5 py-1 rounded-lg bg-primary text-white font-bold text-xs'
    : 'px-2.5 py-1 rounded-lg bg-surface-strong text-text-secondary hover:bg-border-default text-xs';
  let html = `<button onclick="_svPage=Math.max(1,_svPage-1);applyUsersFilter()" ${_svPage===1?'disabled':''} class="${btnCls(false)}">&#8249;</button>`;
  const range = (s,e) => Array.from({length:e-s+1},(_,i)=>s+i);
  let pages;
  if (totalPages <= 7) pages = range(1, totalPages);
  else if (_svPage <= 4) pages = [...range(1,5), -1, totalPages];
  else if (_svPage >= totalPages-3) pages = [1, -1, ...range(totalPages-4, totalPages)];
  else pages = [1, -1, ...[_svPage-1,_svPage,_svPage+1], -1, totalPages];
  pages.forEach(p => {
    if (p === -1) { html += '<span class="px-1 text-text-tertiary">…</span>'; return; }
    html += `<button onclick="_svPage=${p};applyUsersFilter()" class="${btnCls(p===_svPage)}">${p}</button>`;
  });
  html += `<button onclick="_svPage=Math.min(${totalPages},_svPage+1);applyUsersFilter()" ${_svPage===totalPages?'disabled':''} class="${btnCls(false)}">&#8250;</button>`;
  ctrl.innerHTML = html;
}

// ── Side Panel ────────────────────────────────────────────────────────────────
function openSvSidePanel(userId) {
  const u = _allUsers.find(x => x.id === userId);
  if (!u) return;
  _svCurrentUser = u;
  _svPanelTab = 'info';

  // Avatar
  const av = document.getElementById('svPanelAvatar');
  av.className = `w-11 h-11 rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0 ${_svAvatarBg(u.username)}`;
  av.textContent = (u.full_name||u.username).charAt(0).toUpperCase();

  document.getElementById('svPanelName').textContent = u.full_name || u.username;
  const cohort = _cohortFromUsername(u.username);
  const spec   = _SPEC_SHORT[u.specialization] || (u.specialization ? u.specialization.slice(0,12) : 'Chưa có CN');
  document.getElementById('svPanelMeta').textContent = `${u.username} · ${cohort?'K'+cohort:''} · ${spec}`;

  // Wire footer buttons
  document.getElementById('svPanelBtnReset').onclick  = () => resetUserPassword(u.id, u.username);
  document.getElementById('svPanelBtnGrades').onclick = () => viewUserGrades(u.id, u.full_name||u.username);
  document.getElementById('svPanelBtnDel').onclick    = () => deleteUser(u.id, u.username);

  // Open panel: slide-in fixed overlay
  const panel = document.getElementById('svSidePanel');
  const overlay = document.getElementById('svPanelOverlay');
  panel.classList.remove('hidden');
  overlay?.classList.remove('hidden');
  // Trigger transform sau khi đã ra khỏi 'hidden' để có animation
  requestAnimationFrame(() => { panel.style.transform = 'translateX(0)'; });
  // Đẩy floating chat sang trái để không che footer side panel
  _shiftFloatingChat(true);

  switchSvPanelTab('info');

  // Highlight active row (chỉ áp dụng nếu đang ở tab Sinh viên)
  document.querySelectorAll('#svGroupedTable tr[data-uid]').forEach(r => r.classList.remove('bg-accent-soft'));
  const row = document.querySelector(`#svGroupedTable tr[onclick*="openSvSidePanel(${u.id})"]`);
  if (row) row.classList.add('bg-accent-soft');
}

function closeSvSidePanel() {
  const panel = document.getElementById('svSidePanel');
  const overlay = document.getElementById('svPanelOverlay');
  if (!panel) return;
  panel.style.transform = 'translateX(100%)';
  setTimeout(() => {
    panel.classList.add('hidden');
    overlay?.classList.add('hidden');
  }, 260);
  _shiftFloatingChat(false);
  _svCurrentUser = null;
}

// Đẩy floating-chat FAB + panel chat sang trái khi side panel SV mở
function _shiftFloatingChat(active) {
  const fab = document.getElementById('fcFab');
  const fcPanel = document.getElementById('fcPanel');
  // Side panel SV chiếm 380px (max 92vw); offset = panel width + 24px gap
  const offset = active ? 'calc(min(380px, 92vw) + 24px)' : '24px';
  if (fab) {
    if (!fab.style.transition) fab.style.transition = 'right .25s ease';
    fab.style.right = offset;
  }
  if (fcPanel) {
    if (!fcPanel.style.transition) fcPanel.style.transition = 'right .25s ease';
    fcPanel.style.right = offset;
  }
}

function switchSvPanelTab(tab) {
  _svPanelTab = tab;
  const tabs = { info: 'svPanelTabInfo', grades: 'svPanelTabGrades', progress: 'svPanelTabProgress' };
  const activeClass = 'flex-1 py-2.5 text-xs font-semibold text-primary border-b-2 border-primary';
  const inactiveClass = 'flex-1 py-2.5 text-xs font-semibold text-text-tertiary border-b-2 border-transparent hover:text-text-secondary transition-colors';
  Object.entries(tabs).forEach(([t, id]) => {
    const el = document.getElementById(id);
    if (el) el.className = t === tab ? activeClass : inactiveClass;
  });
  const u = _svCurrentUser;
  if (!u) return;
  const content = document.getElementById('svPanelContent');
  if (tab === 'info')     content.innerHTML = _svPanelInfoHtml(u);
  if (tab === 'grades')   content.innerHTML = _svPanelGradesHtml(u);
  if (tab === 'progress') content.innerHTML = _svPanelProgressHtml(u);
}

