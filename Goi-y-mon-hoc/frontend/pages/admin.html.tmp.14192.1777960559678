// ── Field change → mark dirty ─────────────────────────────────────────────
function _crsPanelChange(field, value) {
  if (!_crsPanelDraft) return;
  _crsPanelDraft[field] = value;
  _crsCheckDirty();
  _crsUpdateDirtyUI();
  // Re-render basic tab nếu đổi count_toward_credits hoặc elective_group (visual update)
  if (_crsPanelTab === 'basic' && (field === 'count_toward_credits' || field === 'elective_group')) {
    document.getElementById('crsPanelBody').innerHTML = _crsRenderBasicTab();
  }
}
window._crsPanelChange = _crsPanelChange;

function _crsPanelToggleSpec(specCode, checked) {
  if (!_crsPanelDraft) return;
  let specs = _crsPanelDraft.specializations || [];
  if (checked) {
    if (!specs.includes(specCode)) specs.push(specCode);
  } else {
    specs = specs.filter(s => s !== specCode);
  }
  _crsPanelDraft.specializations = specs;
  // Sync legacy field nếu đúng 1 spec
  _crsPanelDraft.required_specialization = specs.length === 1 ? specs[0] : null;
  _crsCheckDirty();
  _crsUpdateDirtyUI();
  document.getElementById('crsPanelBody').innerHTML = _crsRenderBasicTab();
}
window._crsPanelToggleSpec = _crsPanelToggleSpec;

function _crsPanelTogglAllSpecs(checked) {
  if (!_crsPanelDraft) return;
  if (checked) {
    _crsPanelDraft.specializations = [];
    _crsPanelDraft.required_specialization = null;
  }
  _crsCheckDirty();
  _crsUpdateDirtyUI();
  document.getElementById('crsPanelBody').innerHTML = _crsRenderBasicTab();
}
window._crsPanelTogglAllSpecs = _crsPanelTogglAllSpecs;

function _crsPanelRemovePrereq(code) {
  if (!_crsPanelDraft) return;
  _crsPanelDraft.prereqs = (_crsPanelDraft.prereqs || []).filter(p => p !== code);
  _crsCheckDirty();
  _crsUpdateDirtyUI();
  document.getElementById('crsPanelBody').innerHTML = _crsRenderPrereqTab();
}
window._crsPanelRemovePrereq = _crsPanelRemovePrereq;

function _crsPanelFilterPrereqSearch(q) {
  const box = document.getElementById('crsPanelPrereqSuggestions');
  q = (q || '').trim().toLowerCase();
  if (!q || q.length < 2) { box.classList.add('hidden'); return; }
  const data = _crsDataCache[_crsSpec];
  const all = [...(data?.compulsory || []), ...(data?.elective_a?.courses || []), ...(data?.elective_b?.courses || []), ...(data?.elective_c?.courses || [])];
  const own = _crsPanelDraft?.course_code;
  const existing = new Set(_crsPanelDraft?.prereqs || []);
  const matches = all.filter(c => c.course_code !== own && !existing.has(c.course_code) &&
    (c.course_code.toLowerCase().includes(q) || c.course_name.toLowerCase().includes(q))).slice(0, 12);
  if (!matches.length) { box.innerHTML = '<p class="px-3 py-2 text-xs text-text-tertiary">Không tìm thấy</p>'; box.classList.remove('hidden'); return; }
  box.innerHTML = matches.map(c => `
    <button onclick="_crsPanelAddPrereq('${escHtml(c.course_code)}')"
      class="w-full px-3 py-2 text-left hover:bg-accent-soft transition-colors flex items-center gap-2 text-xs">
      <span class="font-mono text-text-tertiary">${escHtml(c.course_code)}</span>
      <span class="text-text-primary truncate">${escHtml(c.course_name)}</span>
    </button>
  `).join('');
  box.classList.remove('hidden');
}
window._crsPanelFilterPrereqSearch = _crsPanelFilterPrereqSearch;

function _crsPanelAddPrereq(code) {
  if (!_crsPanelDraft) return;
  if (!_crsPanelDraft.prereqs) _crsPanelDraft.prereqs = [];
  if (!_crsPanelDraft.prereqs.includes(code)) _crsPanelDraft.prereqs.push(code);
  _crsCheckDirty();
  _crsUpdateDirtyUI();
  document.getElementById('crsPanelBody').innerHTML = _crsRenderPrereqTab();
}
window._crsPanelAddPrereq = _crsPanelAddPrereq;

// ── Dirty tracking ────────────────────────────────────────────────────────
function _crsCheckDirty() {
  if (!_crsPanelOriginal || !_crsPanelDraft) { _crsPanelDirty = false; return; }
  const fields = ['course_name', 'credits', 'description', 'count_toward_credits', 'typical_semester', 'elective_group', 'required_specialization'];
  const changed = fields.some(f => JSON.stringify(_crsPanelOriginal[f]) !== JSON.stringify(_crsPanelDraft[f]));
  const specChanged = JSON.stringify((_crsPanelOriginal.specializations || []).slice().sort()) !==
                      JSON.stringify((_crsPanelDraft.specializations || []).slice().sort());
  const prereqChanged = JSON.stringify((_crsPanelOriginal.prereqs || []).slice().sort()) !==
                        JSON.stringify((_crsPanelDraft.prereqs || []).slice().sort());
  _crsPanelDirty = changed || specChanged || prereqChanged;
}

function _crsUpdateDirtyUI() {
  const bar = document.getElementById('crsPanelDirtyBar');
  const saveBtn = document.getElementById('crsPanelBtnSave');
  const revertBtn = document.getElementById('crsPanelBtnRevert');
  if (!bar) return;
  if (_crsPanelDirty) {
    bar.classList.remove('hidden');
    saveBtn?.removeAttribute('disabled');
    revertBtn?.removeAttribute('disabled');
  } else {
    bar.classList.add('hidden');
    saveBtn?.setAttribute('disabled', 'disabled');
    revertBtn?.setAttribute('disabled', 'disabled');
