async function submitEditStudent() {
  const id = document.getElementById('editStudentId').value;
  const name = document.getElementById('editStudentName').value.trim();
  const cohort = document.getElementById('editStudentCohort').value.trim();
  const spec = document.getElementById('editStudentSpec').value;
  const email = document.getElementById('editStudentEmail').value.trim();
  const errEl = document.getElementById('editStudentError');
  errEl.classList.add('hidden');

  if (!name) { errEl.textContent = 'Vui lòng nhập họ tên.'; errEl.classList.remove('hidden'); return; }
  if (cohort && !/^\d{2}$/.test(cohort)) { errEl.textContent = 'Khoá phải là 2 chữ số.'; errEl.classList.remove('hidden'); return; }

  const btn = document.getElementById('btnEditStudentSubmit');
  btn.disabled = true; btn.textContent = 'Đang lưu...';
  try {
    // Email KHÔNG gửi — email cá nhân do SV tự đặt qua flow Gmail OAuth (làm sau).
    // Admin chỉ xem read-only, không sửa.
    const res = await fetch(`${API_BASE}/admin/users/${id}`, {
      method: 'PATCH',
      headers: { ...auth(), 'Content-Type': 'application/json' },
      body: JSON.stringify({
        full_name: name,
        cohort: cohort || '',  // "" → null
        specialization: spec,   // "" → clear; mã hợp lệ → set
      }),
    });
    const data = await res.json();
    if (!res.ok) {
      errEl.textContent = data.detail || 'Lỗi cập nhật';
