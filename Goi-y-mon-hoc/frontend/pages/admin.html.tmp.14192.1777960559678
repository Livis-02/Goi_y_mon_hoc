    // Check if this spec has no advisors at all → first one must be head
    const specAdvisors = _advisorsList.filter(a => (a.managed_specialization || '') === spec);
    if (specAdvisors.length === 0) {
      headChk.checked = true;
      headChk.disabled = true;
      warnEl.classList.add('hidden');
      hintEl.classList.remove('hidden');
      return;
    } else {
      headChk.disabled = false;
      hintEl.classList.add('hidden');
    }
  }

  if (!isHead) { warnEl.classList.add('hidden'); warnEl.textContent = ''; return; }
  const existing = _findExistingHead(spec, editId);
  if (existing) {
    const specName = _SPEC_FULL[spec] || 'Năm đại cương';
    warnEl.textContent = `Chuyên ngành ${specName} đã có trưởng: ${existing.full_name || existing.username}`;
    warnEl.classList.remove('hidden');
    headChk.checked = false;
  } else {
    warnEl.classList.add('hidden');
    warnEl.textContent = '';
  }
}

