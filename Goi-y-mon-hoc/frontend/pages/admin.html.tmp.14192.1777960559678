async function downloadGradReportCsv() {
  const params = _gradReportParams();
  params.set('format', 'csv');
  const tok = (typeof getToken === 'function') ? getToken() : (localStorage.getItem('access_token') || '');
  try {
    const res = await fetch(`${API_BASE}/admin/reports/graduation?${params}`, {
      headers: { Authorization: 'Bearer ' + tok },
    });
    if (!res.ok) {
      toast('Lỗi tải báo cáo: HTTP ' + res.status, 'error');
      return;
    }
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    const cd = res.headers.get('Content-Disposition') || '';
    const m = cd.match(/filename="([^"]+)"/);
    a.download = m ? m[1] : `graduation_report_${Date.now()}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    toast('Đã tải báo cáo CSV', 'success');
  } catch (e) {
    toast('Lỗi: ' + (e.message || 'unknown'), 'error');
  }
}
window.downloadGradReportCsv = downloadGradReportCsv;

