function _getNfTargetValue() {
  const tt = document.getElementById('nfTargetType').value;
  if (tt === 'cohort') return document.getElementById('nfCohortInput')?.value.trim() || '';
  if (tt === 'specialization') {
    return Array.from(document.querySelectorAll('.nf-spec-cb:checked')).map(c => c.value).join(',');
  }
  if (tt === 'students') return document.getElementById('nfStudentInput')?.value.trim() || '';
  if (tt === 'advisors') return document.getElementById('nfAdvisorInput')?.value.trim() || '';
  if (tt === 'department') return document.getElementById('nfDeptSelect')?.value || '';
  return '';
}

function _scheduleNfEstimate() {
  clearTimeout(_nfEstimateTimer);
  _nfEstimateTimer = setTimeout(_updateNfEstimate, 500);
}

async function _updateNfEstimate() {
  const tt = document.getElementById('nfTargetType').value;
  const tv = _getNfTargetValue();
  const res = await callApi(
    `/admin/notifications/estimate-reach?target_type=${encodeURIComponent(tt)}&target_value=${encodeURIComponent(tv)}`,
    { headers: auth() }
  );
  const el = document.getElementById('nfEstimateCount');
  if (el) el.textContent = res.ok ? (res.data.count ?? '—') : '—';
}

async function submitNotification() {
  const title   = document.getElementById('nfTitle').value.trim();
  const content = document.getElementById('nfContent').value.trim();
  const severity = document.querySelector('input[name="nfSeverity"]:checked')?.value || 'info';
  const target_type = document.getElementById('nfTargetType').value;
  const target_value = _getNfTargetValue();
  const errEl = document.getElementById('nfErr');
  errEl.classList.add('hidden');

  if (!title) { errEl.textContent = 'Vui lòng nhập tiêu đề.'; errEl.classList.remove('hidden'); return; }
  if (!content) { errEl.textContent = 'Vui lòng nhập nội dung.'; errEl.classList.remove('hidden'); return; }

  const res = await callApi('/admin/notifications', {
    method: 'POST', headers: { ...auth(), 'Content-Type': 'application/json' },
    body: JSON.stringify({ title, content, severity, target_type, target_value: target_value || null }),
  });
  if (!res.ok) { errEl.textContent = extractError(res.data); errEl.classList.remove('hidden'); return; }
  closeNotifModal();
  toast('Đã gửi thông báo!');
  loadNotificationsTab();
}

function deactivateNotif(id) {
  _confirm('Thu hồi thông báo này?', async () => {
    const res = await callApi(`/admin/notifications/${id}/deactivate`, {
      method: 'PATCH', headers: auth(),
    });
    if (!res.ok) { toast(extractError(res.data), false); return; }
    toast('Đã thu hồi thông báo');
    loadNotificationsTab();
  }, 'Thu hồi');
}

function deleteNotif(id) {
  _confirm('Xóa hẳn thông báo này? Không thể phục hồi.', async () => {
    const res = await callApi(`/admin/notifications/${id}`, { method: 'DELETE', headers: auth() });
    if (!res.ok) { toast(extractError(res.data), false); return; }
    toast('Đã xóa thông báo');
    loadNotificationsTab();
  });
}

