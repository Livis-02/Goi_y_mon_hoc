              <td class="px-3 py-2 text-center ${g._strange ? 'text-text-tertiary' : ''}">${fmtScore(g.score10, 1)}</td>
              <td class="px-3 py-2 text-center font-bold ${g._strange ? 'text-text-tertiary' : g.passed === false ? 'text-danger' : g.passed ? 'text-success' : 'text-text-tertiary'}">${g.letter ?? '—'}</td>
