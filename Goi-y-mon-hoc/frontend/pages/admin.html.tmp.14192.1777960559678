// ── Bulk: Export CSV ──────────────────────────────────────────────────────────
function bulkExportCsv() {
  const checked = [...document.querySelectorAll('.sv-cb:checked')].map(cb => parseInt(cb.dataset.uid));
  if (!checked.length) return;
  // Lookup user data từ _allUsers (đã load)
  const users = (_allUsers || []).filter(u => checked.includes(u.id));
  if (!users.length) { toast('Không tìm thấy data SV', 'error'); return; }
  // CSV header + rows
  const headers = ['Mã SV', 'Họ tên', 'Email', 'Khoá', 'Chuyên ngành', 'Cố vấn', 'GPA', 'Số TC', 'Đăng nhập lần đầu'];
  const rows = users.map(u => [
    u.username || '',
    u.full_name || '',
    u.email || '',
    _cohortFromUsername(u.username) ? `K${_cohortFromUsername(u.username)}` : '',
    u.specialization || '',
    u.advisor_full_name || u.advisor_teacher_code || '',
    u.avg_score4 != null ? Number(u.avg_score4).toFixed(2) : '',
    u.official_earned_credits || '',
    u.default_password ? 'Chưa đổi MK' : 'Đã đổi MK',
  ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(','));
  const csv = '﻿' + [headers.join(','), ...rows].join('\n');  // BOM cho Excel UTF-8
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  const ts = new Date().toISOString().slice(0, 10);
  a.download = `eduguide_sinhvien_${ts}.csv`;
  document.body.appendChild(a);
  a.click();
  setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 1000);
  toast(`Đã xuất ${users.length} SV ra CSV`);
}

