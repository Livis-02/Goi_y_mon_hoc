// Tìm course object trong dataset hiện tại (theo course_code)
function _crsFindCourse(courseCode) {
  const data = _crsDataCache[_crsSpec];
  if (!data) return null;
  for (const arr of [data.compulsory, data.elective_a?.courses, data.elective_b?.courses, data.elective_c?.courses]) {
    const c = arr?.find(x => x.course_code === courseCode);
    if (c) return c;
  }
  return null;
}

// Mở side panel cho 1 môn
async function openCourseSidePanel(courseCode) {
  const c = _crsFindCourse(courseCode);
  if (!c) { toast('Không tìm thấy môn ' + courseCode, 'error'); return; }
  _crsPanelCourseId = c.id;
  _crsPanelOriginal = JSON.parse(JSON.stringify(c));
  _crsPanelDraft    = JSON.parse(JSON.stringify(c));
  _crsPanelTab      = 'content';   // chỉ còn 1 view "Mô tả + Kỹ năng" (no tabs)
  _crsPanelDirty    = false;

  // Header
  document.getElementById('crsPanelCode').textContent = c.course_code;
  document.getElementById('crsPanelName').textContent = c.course_name;
  // Meta badges
  const credits = c.credits != null ? `${c.credits} TC` : '—';
  const groupLabel = (
    c.elective_group === 'A' ? 'TC-A' :
    c.elective_group === 'B' ? 'TC-B' :
    c.elective_group === 'C' ? 'TC-C' : 'BB'
  );
  const specCount = (c.specializations?.length || (c.required_specialization ? 1 : 0));
  const specLabel = specCount === 0 ? 'Chung' : specCount + ' CN';
  document.getElementById('crsPanelMeta').innerHTML = `
    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-accent-soft text-accent">${groupLabel}</span>
    <span class="text-[11px] text-text-tertiary">${credits}</span>
    <span class="text-text-tertiary">·</span>
    <span class="text-[11px] text-text-tertiary">${specLabel}</span>
  `;

  // Show panel
  const overlay = document.getElementById('crsPanelOverlay');
  const panel   = document.getElementById('crsSidePanel');
  overlay.classList.remove('hidden');
  panel.classList.remove('hidden');
  panel.style.display = 'flex';
  requestAnimationFrame(() => {
    panel.style.transform = 'translateX(0)';
  });

  _crsSwitchTab('content');  // mở thẳng view Mô tả + Kỹ năng
  _crsUpdateDirtyUI();
  // Load skills inline vào panel (thay cho modal stacked)
  _crsLoadSkillsInline(c.course_code);
}

// Load + render skills directly inside side panel (no modal stack)
async function _crsLoadSkillsInline(courseCode) {
  _skillsCurrentCourse = courseCode;
  _skillsSelected = {};
  // Sử dụng cùng cache + endpoint với modal cũ
  const [allSkills, currentRes] = await Promise.all([
    _ensureSkillsCache(),
    callApi(`/courses/${encodeURIComponent(courseCode)}/skills`, { headers: auth() }),
  ]);
  if (currentRes.ok && Array.isArray(currentRes.data)) {
    currentRes.data.forEach(s => { _skillsSelected[s.skill_code] = s.weight; });
  }
  _crsRenderSkillsInline(allSkills);
}

function _crsRenderSkillsInline(allSkills) {
  const host = document.getElementById('crsPanelSkillsHost');
  if (!host) return;
  // Group by category — same logic as modal
  const byCat = {};
  allSkills.forEach(s => { (byCat[s.category] = byCat[s.category] || []).push(s); });
  const html = Object.entries(byCat).map(([cat, skills]) => {
    const catLabel = (typeof _SKILL_CAT_LABEL !== 'undefined' && _SKILL_CAT_LABEL[cat]) || cat;
    return `<div>
      <p class="text-[10px] font-bold uppercase tracking-wider text-text-tertiary mb-1.5">${catLabel}</p>
      <div class="flex flex-wrap gap-1.5">
        ${skills.map(s => {
          const checked = s.code in _skillsSelected;
          const weight = _skillsSelected[s.code] || 1.0;
          return `<label class="inline-flex items-center gap-1.5 px-2 py-1 rounded border cursor-pointer transition-all ${checked ? 'bg-accent-soft-hi border-accent border-2' : 'bg-surface border-border-default hover:bg-surface-strong'}">
            <input type="checkbox" ${checked ? 'checked' : ''}
              onchange="_crsTogglePanelSkill('${s.code}', this.checked)"
              class="accent-violet-600 w-3.5 h-3.5"/>
            <span class="text-xs font-medium">${escHtml(s.name)}</span>
            ${checked ? `<input type="range" min="0.3" max="1" step="0.1" value="${weight}"
              oninput="_crsUpdatePanelSkillWeight('${s.code}', this.value); this.nextElementSibling.textContent=parseFloat(this.value).toFixed(1);"
              onclick="event.stopPropagation()"
              class="w-14 h-1 ml-1 accent-violet-600"/>
              <span class="text-[10px] text-accent font-bold w-6">${weight.toFixed(1)}</span>` : ''}
          </label>`;
        }).join('')}
      </div>
    </div>`;
  }).join('');
  host.innerHTML = html || '<p class="text-xs text-text-tertiary italic">Chưa có skill nào trong hệ thống.</p>';
  _crsUpdatePanelSkillsCount();
}

