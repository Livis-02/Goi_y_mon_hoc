function _svAssignAdvisor(svId, username) {
  switchAdminTab('advisors');
  setTimeout(() => {
    const sv = _allUsers.find(u => u.id === svId);
    if (!sv) return;
    // Auto-match advisor by specialization heuristic — pick first GV cùng CN
    const spec = sv.specialization;
    const specCode = Object.entries(_SPEC_CODE_TO_NAME || {}).find(([, n]) => n === spec)?.[0] || null;
    const match = (_advisorsList || []).find(a => a.managed_specialization === specCode);
    if (match) {
      openAssignPanel(match.id, match.full_name || match.username);
      toast(`Mở panel của ${match.full_name}. Thêm ${username} vào danh sách.`, 'info');
    } else {
      toast(`Chọn cố vấn phù hợp cho ${username}`, 'info');
    }
  }, 300);
}

