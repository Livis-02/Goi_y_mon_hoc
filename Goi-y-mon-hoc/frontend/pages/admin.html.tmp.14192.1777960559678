<!DOCTYPE html>
<html class="light" lang="vi">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Quản lý CTĐT - Gợi ý Môn học CNTT</title>
  <link rel="stylesheet" href="theme.css?v=11"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="theme.js?v=6"></script>
  <script src="theme-switcher.js?v=2"></script>
  <script src="app-core.js?v=1"></script>
  <script src="utils.js?v=2"></script>
  <script src="nav-prefetch.js?v=1" defer></script>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script defer src="scroll-helpers.js?v=v2"></script>
  <script defer src="ajax-nav.js?v=16"></script>
  <style>
    /* Admin page-specific only — shared styles live in theme.css */
    /* Modal */
    #modal { display: none; } #modal.open { display: flex; }
    /* Toast */
    #toast { transition: opacity .3s; }
    /* Bulk action bar slide-in animation */
    @keyframes __bulkBarIn {
      from { opacity: 0; transform: translate(-50%, 16px); }
      to   { opacity: 1; transform: translate(-50%, 0); }
    }
  </style>
</head>
<body class="bg-canvas text-text-primary antialiased min-h-screen">

<!-- ── SIDEBAR (injected from sidebar-admin.html) ────────────────────────── -->
<div id="adminSidebarMount"></div>

<!-- ── TOPBAR ───────────────────────────────────────────────────────────────── -->
<header class="topbar flex items-center justify-between px-4 lg:px-6">
  <div class="flex items-center gap-3 min-w-0">
    <button onclick="toggleAdminSidebar()" class="lg:hidden p-1.5 rounded-md hover:bg-surface-subtle transition-colors" aria-label="Menu">
      <span class="material-symbols-outlined msym text-xl text-text-secondary">menu</span>
    </button>
    <nav class="flex items-center gap-1.5 text-[13px] min-w-0">
      <span class="text-text-tertiary font-medium">Admin</span>
      <span class="material-symbols-outlined msym text-base text-text-tertiary">chevron_right</span>
      <span class="text-text-primary font-semibold" id="adminBreadcrumb">Tổng quan</span>
    </nav>
    <span class="hidden" id="adminPageTitle">Tổng quan</span>
  </div>
  <div class="flex items-center gap-2">
    <!-- Note: bỏ topbar search + add button — duplicate với controls in-tab.
         Trước đây có search "Tìm mã môn" + "Import CTĐT" ở topbar nhưng:
         (1) trùng lặp 100% với search/import bên trong tab Môn học
         (2) physically xa content → cảm giác tách biệt
         (3) chỉ active trên 1/6 tab → confusing
         Giữ lại chỉ theme toggle (global, không liên quan tab nào). -->
    <button class="theme-toggle" data-tooltip="Sáng/Tối">
      <span class="material-symbols-outlined msym text-[18px] icon-moon">dark_mode</span>
      <span class="material-symbols-outlined msym text-[18px] icon-sun">light_mode</span>
    </button>
  </div>
</header>

<!-- ── MAIN CONTENT ────────────────────────────────────────────────────────── -->
<main class="lg:ml-60 pt-[60px] px-4 lg:px-6 pb-12 min-h-screen">

  <!-- ── DASHBOARD TAB ────────────────────────────────────────────────────── -->
  <div id="adminTab-dashboard" class="space-y-5">

    <!-- Loading -->
    <div id="dashboardLoading" class="py-12 flex items-center justify-center text-text-tertiary gap-2">
      <span class="material-symbols-outlined animate-spin">progress_activity</span>
      <span class="text-sm">Đang tải...</span>
    </div>

    <!-- Content (hidden until loaded) -->
    <div id="dashboardContent" class="hidden space-y-5">

      <!-- ① Stat cards (1 hàng 5 cột) — compact -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3" id="dashboardCards"></div>

      <!-- ② Charts row: Cohort bar + Spec doughnut -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="card p-5">
          <p class="eyebrow mb-4">Phân bố sinh viên theo khóa</p>
          <div class="relative" style="height:200px">
            <canvas id="dashCohortChart"></canvas>
          </div>
        </div>
        <div class="card p-5">
          <p class="eyebrow mb-4">Phân bố theo chuyên ngành</p>
          <div class="relative" style="height:200px">
            <canvas id="dashSpecChart"></canvas>
          </div>
        </div>
      </div>

      <!-- ③ Cảnh báo hệ thống -->
      <div class="card p-5">
        <p class="eyebrow mb-3">Cảnh báo hệ thống</p>
        <div id="dashWarnings" class="space-y-2"></div>
      </div>

      <!-- ④ Hoạt động gần đây -->
      <div class="card overflow-hidden">
        <div class="px-5 py-4 border-b border-border-subtle flex items-center justify-between">
          <p class="eyebrow">Hoạt động gần đây</p>
        </div>
        <div id="dashRecentLogs" class="divide-y divide-border-subtle">
          <p class="px-5 py-6 text-sm text-text-tertiary text-center">Đang tải...</p>
        </div>
      </div>

      <!-- ⑤ System info footer -->
      <div id="dashboardExtra" class="bg-surface-subtle rounded-xl px-5 py-3 border border-border-subtle">
        <div class="flex flex-wrap gap-6 text-sm text-text-secondary">
          <span>Hoạt động tuần này: <strong id="dashActiveWeek" class="text-accent">—</strong> SV</span>
          <span>Thông báo đã gửi: <strong id="dashNotifTotal" class="text-accent">—</strong>
            (tỷ lệ đọc: <strong id="dashNotifRate" class="text-accent">—</strong>)</span>
        </div>
      </div>

      <!-- Section "Báo cáo tốt nghiệp" đã BỎ ở refactor 2026-05-05.
           Mô hình mới: tool nội bộ — báo cáo TN xem ở SIS chính thức của trường. -->

    </div><!-- /dashboardContent -->
  </div>

  <!-- ── COURSES TAB ─────────────────────────────────────────────────────────────── -->
  <div id="adminTab-courses" class="hidden space-y-4 pt-5">

    <!-- ① Stats strip — 4 KPI cards (3-color discipline: chip-primary/secondary/neutral) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="card p-3 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg chip-primary flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-xl" style="font-variation-settings:'FILL' 1">menu_book</span>
        </div>
        <div class="min-w-0">
          <p class="text-xl font-extrabold text-text-primary leading-none" id="statTotal">—</p>
          <p class="text-[11px] text-text-tertiary mt-1 truncate">Tổng môn</p>
        </div>
      </div>
      <div class="card p-3 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg chip-secondary flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-xl" style="font-variation-settings:'FILL' 1">share</span>
        </div>
        <div class="min-w-0">
          <p class="text-xl font-extrabold text-text-primary leading-none" id="statSharedCourses">—</p>
          <p class="text-[11px] text-text-tertiary mt-1 truncate">Dùng chung</p>
        </div>
      </div>
      <div class="card p-3 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg chip-primary flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-xl" style="font-variation-settings:'FILL' 1">school</span>
        </div>
        <div class="min-w-0">
          <p class="text-xl font-extrabold text-text-primary leading-none" id="statSpecCourses">—</p>
          <p class="text-[11px] text-text-tertiary mt-1 truncate" title="Số môn riêng cho một chuyên ngành cụ thể">Riêng CN</p>
        </div>
      </div>
      <div class="card p-3 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg chip-neutral flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-xl" style="font-variation-settings:'FILL' 1">block</span>
        </div>
        <div class="min-w-0">
          <p class="text-xl font-extrabold text-text-primary leading-none" id="statNoTcCourses">—</p>
          <p class="text-[11px] text-text-tertiary mt-1 truncate">Không tính TC</p>
        </div>
      </div>
    </div>

    <!-- ② Sub-tab: Danh sách môn / Kế hoạch chuẩn -->
    <div class="flex border-b border-border-subtle">
      <button onclick="switchCrsSubTab('list')" id="crsSubTab-list"
        class="px-5 py-2.5 text-sm font-semibold text-primary border-b-2 border-primary flex items-center gap-1.5 transition-colors">
        <span class="material-symbols-outlined text-base">list</span>Danh sách môn
      </button>
      <button onclick="switchCrsSubTab('plan')" id="crsSubTab-plan"
        class="px-5 py-2.5 text-sm font-semibold text-text-tertiary border-b-2 border-transparent hover:text-text-secondary flex items-center gap-1.5 transition-colors">
        <span class="material-symbols-outlined text-base">account_tree</span>Kế hoạch chuẩn
      </button>
    </div>

    <!-- ③ Toolbar — filter + actions, 1 hàng -->
    <div class="bg-surface rounded-xl border border-border-subtle px-3 py-2 shadow-sm flex items-center gap-2 flex-wrap">
      <div class="relative flex-1 min-w-[180px]">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-text-tertiary text-base pointer-events-none">search</span>
        <input autocomplete="off" id="crsSearchInput" type="text" placeholder="Tìm mã hoặc tên môn…"
          class="w-full pl-9 pr-3 py-2 border border-border-default rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20"/>
      </div>
      <select autocomplete="off" id="crsFilterSpec" onchange="switchCrsSpec(this.value)"
        class="border border-border-default rounded-lg px-3 py-2 text-sm bg-surface focus:outline-none focus:ring-2 focus:ring-indigo-500/20 min-w-[160px]">
        <option value="all">Tất cả CN</option>
        <option value="7480201_07">KHMT — Khoa học máy tính</option>
        <option value="7480201_06">MMT — Mạng máy tính</option>
        <option value="7480201_05">CNPM — Công nghệ phần mềm</option>
        <option value="7480201_09">HTTT — Hệ thống thông tin</option>
        <option value="7480201_04">THKT — Tin học kinh tế</option>
        <option value="7480201_08">CNTTDH — CNTT Địa học</option>
      </select>
      <select autocomplete="off" id="crsFilterHk" onchange="applyCrsFilter()"
        class="border border-border-default rounded-lg px-3 py-2 text-sm bg-surface focus:outline-none focus:ring-2 focus:ring-indigo-500/20">
        <option value="">Tất cả HK</option>
        <option value="1">HK 1</option><option value="2">HK 2</option><option value="3">HK 3</option>
        <option value="4">HK 4</option><option value="5">HK 5</option><option value="6">HK 6</option>
        <option value="7">HK 7</option><option value="8">HK 8</option><option value="9">HK 9</option>
      </select>
      <select autocomplete="off" id="crsFilterSort" onchange="applyCrsFilter()"
        class="border border-border-default rounded-lg px-3 py-2 text-sm bg-surface focus:outline-none focus:ring-2 focus:ring-indigo-500/20">
        <option value="hk">Theo HK</option>
        <option value="code">Theo mã</option>
        <option value="credits">Theo TC</option>
      </select>
      <span id="crsFilterCount" class="text-xs text-text-tertiary whitespace-nowrap"></span>
      <span class="flex-1"></span>
      <button onclick="openCtdtImportModal()"
        class="flex items-center gap-1 px-3 py-2 bg-emerald-600 text-white rounded-lg text-xs font-bold hover:bg-emerald-700 transition-colors">
        <span class="material-symbols-outlined text-sm">upload_file</span>Import CTĐT
      </button>
      <button onclick="doMlRetrain()"
        class="flex items-center gap-1 px-3 py-2 bg-violet-600 text-white rounded-lg text-xs font-bold hover:bg-violet-700 transition-colors">
        <span class="material-symbols-outlined text-sm">model_training</span>Retrain ML
        <span id="mlSpinner" class="hidden ml-1"><span class="material-symbols-outlined text-xs spin">progress_activity</span></span>
      </button>
      <button onclick="loadCrsForSpec(_crsSpec, true)" title="Tải lại"
        class="p-2 text-text-tertiary hover:bg-surface-strong rounded-lg transition-colors">
        <span class="material-symbols-outlined text-base">refresh</span>
      </button>
    </div>

    <!-- ④ Main area -->
    <div class="flex gap-4 items-start" id="crsMainArea">

      <!-- Content column -->
      <div class="flex-1 min-w-0 space-y-3">
        <div id="crsLoading" class="bg-surface rounded-xl p-4 shadow-sm border border-border-subtle space-y-2">
          <!-- Skeleton cards giả lập course rows trong khi load -->
          <div class="skeleton h-10 rounded-md"></div>
          <div class="skeleton h-10 rounded-md"></div>
          <div class="skeleton h-10 rounded-md"></div>
          <div class="skeleton h-10 rounded-md"></div>
          <div class="skeleton h-10 rounded-md"></div>
        </div>
        <div id="crsListView" class="hidden space-y-3">
          <!-- Hint edit — gọn hơn banner L1/L2 cũ. Click row môn để mở panel chi tiết. -->
          <div class="flex items-center gap-2 px-3 py-2 bg-accent-soft/40 border border-accent-soft-hi rounded-xl text-[11px] text-text-secondary">
            <span class="material-symbols-outlined text-accent text-base">touch_app</span>
            <span><strong class="text-accent">Click vào dòng môn</strong> để xem &amp; chỉnh sửa toàn bộ thông tin trong side panel.</span>
            <span class="text-text-tertiary mx-1">·</span>
            <button onclick="openCtdtImportModal()" class="text-accent font-semibold hover:underline">Import CTĐT</button>
            <span class="text-text-tertiary">cho cập nhật hàng loạt từ file.</span>
          </div>
          <div id="crsGroupCompulsory"></div>
          <div id="crsGroupA"></div>
          <div id="crsGroupB"></div>
          <div id="crsGroupC"></div>
        </div>
        <div id="crsPlanView" class="hidden">
          <div class="bg-surface rounded-xl shadow-sm border border-border-subtle overflow-hidden">
            <!-- Chart header — title + legend + edit button -->
            <div class="px-4 py-3 border-b border-border-subtle flex items-center gap-x-4 gap-y-2 flex-wrap bg-gradient-to-r from-surface-subtle/60 to-white">
              <div class="flex items-center gap-2 min-w-0">
                <span class="material-symbols-outlined text-accent" style="font-variation-settings:'FILL' 1">account_tree</span>
                <h3 class="font-bold text-sm text-text-primary whitespace-nowrap">Sơ đồ kế hoạch chuẩn</h3>
                <span id="crsPlanSpecLabel" class="text-xs text-text-tertiary truncate"></span>
              </div>
              <div class="flex items-center gap-3 text-[11px] text-text-tertiary flex-wrap">
                <span class="flex items-center gap-1.5"><span class="inline-block w-2 h-2 rounded-full bg-indigo-600"></span>Bắt buộc</span>
                <span class="flex items-center gap-1.5"><span class="inline-block w-2 h-2 rounded-full bg-emerald-600"></span>Tự chọn A</span>
                <span class="flex items-center gap-1.5"><span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>Tự chọn B</span>
                <span class="flex items-center gap-1.5"><span class="inline-block w-2 h-2 rounded-full bg-violet-600"></span>Tự chọn C</span>
                <span class="text-text-tertiary">·</span>
                <span class="text-text-tertiary">→ tiên quyết</span>
              </div>
              <span class="flex-1"></span>
              <button id="crsPlanEditBtn" onclick="toggleCrsPlanEdit()"
                      class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold border border-border-default bg-surface text-text-secondary hover:bg-accent-soft hover:text-indigo-700 hover:border-indigo-200 transition-colors whitespace-nowrap">
                <span class="material-symbols-outlined text-sm">edit</span>
                <span id="crsPlanEditLabel">Chế độ sửa</span>
              </button>
            </div>

            <!-- Edit-mode hint banner -->
            <div id="crsPlanEditHint" class="hidden text-xs text-warning bg-warning-soft border-b border-amber-100 px-4 py-2">
              <strong>Chế độ sửa đang BẬT.</strong> Kéo card sang HK khác để đổi học kỳ · Kéo từ chấm tròn ○ bên phải card → sang card khác để thêm/xóa tiên quyết.
            </div>

            <!-- Chart body — CHỈ scroll ngang qua các HK. Chiều dọc theo nội dung tự nhiên,
                 không scroll lồng nhau. Toàn trang dùng 1 scroll dọc (nếu cần) — giảm "nhập nhằng". -->
            <div class="overflow-x-auto bg-surface-subtle/40">
              <div id="crsPlanContainer" class="relative inline-flex gap-3 p-4">
                <div id="crsPlanInit" class="flex items-center gap-3 py-10 px-6 text-sm text-text-tertiary">
                  <span class="material-symbols-outlined text-text-tertiary text-4xl">grid_view</span>
                  <span>Chọn chuyên ngành để xem kế hoạch chuẩn.</span>
                </div>
              </div>
            </div>

            <!-- Footer hint -->
            <p id="crsPlanHint" class="hidden text-[11px] text-text-tertiary px-4 py-2 border-t border-border-subtle text-center">
              Click môn để xem quan hệ tiên quyết · xanh = cần trước · cam = phụ thuộc vào
            </p>
          </div>
        </div>
        <div id="crsEmpty" class="hidden bg-surface rounded-xl p-10 text-center shadow-sm border border-border-subtle">
          <span class="material-symbols-outlined text-4xl text-text-tertiary block mb-2">search_off</span>
          <p class="text-sm font-semibold text-text-primary mb-1">Không tìm thấy môn học nào</p>
          <p class="text-xs text-text-tertiary mb-4">Thử bỏ bớt filter, hoặc import CTĐT mới nếu DB chưa có data.</p>
          <div class="flex items-center justify-center gap-2 flex-wrap">
            <button onclick="document.getElementById('crsSearchInput').value='';document.getElementById('crsFilterSpec').value='';document.getElementById('crsFilterHk').value='';if(typeof loadCrsForSpec==='function')loadCrsForSpec(_crsSpec,true)"
              class="px-3 py-1.5 rounded-lg bg-surface-strong text-text-secondary text-xs font-semibold hover:bg-border-default transition flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">filter_alt_off</span>
              Xoá filter
            </button>
            <button onclick="openCtdtImportModal()"
              class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-700 transition flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">upload_file</span>
              Import CTĐT mới
            </button>
          </div>
        </div>
      </div>

    </div><!-- /crsMainArea -->

  </div><!-- /adminTab-courses -->



  <!-- ── TAB: QUẢN LÝ SINH VIêN ───────────────────────────────────── -->
  <div id="adminTab-users" class="hidden space-y-4 pt-5">

    <!-- ① Stats strip — chỉ 2 stats có ý nghĩa với tool cá nhân -->
    <div class="grid grid-cols-2 gap-3">
      <div class="bg-surface rounded-xl p-3 shadow-sm border border-border-subtle flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-accent-soft flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-accent text-xl" style="font-variation-settings:'FILL' 1">groups</span>
        </div>
        <div class="min-w-0">
          <p class="text-xl font-extrabold text-text-primary leading-none" id="statTotalUsers">—</p>
          <p class="text-[11px] text-text-tertiary mt-1 truncate">Tổng sinh viên</p>
        </div>
      </div>
      <div class="bg-surface rounded-xl p-3 shadow-sm border border-border-subtle flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-success-soft flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-success text-xl" style="font-variation-settings:'FILL' 1">grade</span>
        </div>
        <div class="min-w-0">
          <p class="text-xl font-extrabold text-text-primary leading-none" id="statUsersWithGrades">—</p>
          <p class="text-[11px] text-text-tertiary mt-1 truncate">SV đã upload điểm cá nhân</p>
        </div>
      </div>
    </div>
    <!-- Hidden placeholder elements để JS không break (statAvgGpa, statGradReady) -->
    <div class="hidden">
      <span id="statAvgGpa"></span>
      <span id="statGradReady"></span>
    </div>

    <!-- Disclaimer banner: data tự khai -->
    <div class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-2.5 text-xs text-amber-800 flex items-start gap-2">
      <span class="material-symbols-outlined text-base text-amber-600 flex-shrink-0">info</span>
      <div>
        <strong>Lưu ý:</strong> Bảng điểm là dữ liệu SV tự upload (mang tính tham khảo).
        Điểm chính thức xem ở cổng SIS của trường. EduGuide là công cụ hỗ trợ SV xây lộ trình học cá nhân.
      </div>
    </div>

    <!-- ② Toolbar — single row gộp filter + secondary actions -->
    <div class="bg-surface rounded-xl border border-border-subtle px-3 py-2 shadow-sm flex items-center gap-2 flex-wrap">
      <div class="relative flex-1 min-w-[180px]">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-text-tertiary text-base pointer-events-none">search</span>
        <input autocomplete="off" id="userSearchInput" type="text" placeholder="Tìm mã hoặc tên SV…"
          class="w-full pl-9 pr-3 py-2 border border-border-default rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
          oninput="applyUsersFilter()"/>
      </div>
      <select autocomplete="off" id="filterCohort" onchange="applyUsersFilter()"
        class="border border-border-default rounded-lg px-3 py-2 text-sm bg-surface focus:outline-none focus:ring-2 focus:ring-indigo-500/20">
        <option value="">Tất cả khóa</option>
      </select>
      <select autocomplete="off" id="filterSpec" onchange="applyUsersFilter()"
