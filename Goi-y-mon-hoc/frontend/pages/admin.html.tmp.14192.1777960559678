<script>
// ── Bulk Grades Upload ────────────────────────────────────────────────────────
let _bgFiles = [];         // File objects
let _bgPreviews = [];      // Preview data per file
let _bgResults  = [];      // Import result per file

async function _bgRunThrottled(items, handler, concurrency = 5) {
  const results = new Array(items.length);
  let index = 0;
  async function worker() {
    while (index < items.length) {
      const i = index++;
      try { results[i] = await handler(items[i], i); }
      catch (e) { results[i] = { error: e.message }; }
    }
  }
  const workers = Array(Math.min(concurrency, items.length)).fill(0).map(() => worker());
  await Promise.all(workers);
  return results;
}

function openAdminBulkGradesModal() {
  _bgFiles = []; _bgPreviews = []; _bgResults = [];
  _bgShowPhase(1);
  document.getElementById('bgFileList').classList.add('hidden');
  document.getElementById('bgPreviewBar').classList.add('hidden');
  document.getElementById('bgFileInput').value = '';
  document.getElementById('modalBulkGrades').classList.remove('hidden');
  document.getElementById('modalBulkGrades').classList.add('flex');
}
function closeAdminBulkGradesModal() {
  const pwRows = _bgGetPasswordRows();
  if (pwRows.length > 0) {
    const cb = document.getElementById('bgPwAcked');
    if (!cb?.checked) {
      toast('Phải tick "Đã lưu mật khẩu" trước khi đóng', false);
      return;
    }
  }
  document.getElementById('modalBulkGrades').classList.add('hidden');
  document.getElementById('modalBulkGrades').classList.remove('flex');
  loadUsersTab();
}
function _bgShowPhase(n) {
  [1,2,3].forEach(i => document.getElementById(`bgPhase${i}`).classList.toggle('hidden', i !== n));
}

function bgHandleFileSelect(files) {
  for (const f of files) {
    if (!_bgFiles.find(x => x.name === f.name && x.size === f.size)) _bgFiles.push(f);
  }
  _bgRenderFileList();
}
function bgHandleDrop(ev) {
  bgHandleFileSelect(ev.dataTransfer.files);
}
function _bgRenderFileList() {
  const el = document.getElementById('bgFileList');
  const bar = document.getElementById('bgPreviewBar');
  if (!_bgFiles.length) { el.classList.add('hidden'); bar.classList.add('hidden'); return; }
  el.classList.remove('hidden'); bar.classList.remove('hidden');
  document.getElementById('bgFileCount').textContent = `${_bgFiles.length} file được chọn`;
  el.innerHTML = _bgFiles.map((f,i) => `
    <div class="flex items-center gap-3 px-4 py-2.5 bg-surface-subtle rounded-xl border border-border-default">
      <span class="material-symbols-outlined text-accent text-base flex-shrink-0">description</span>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium truncate">${escHtml(f.name)}</p>
        <p class="text-xs text-text-tertiary">${(f.size/1024).toFixed(1)} KB</p>
      </div>
      <button onclick="_bgRemoveFile(${i})" class="text-text-tertiary hover:text-danger transition-colors p-1">
        <span class="material-symbols-outlined text-base">close</span>
      </button>
    </div>`).join('');
}
function _bgRemoveFile(idx) {
  _bgFiles.splice(idx, 1);
  _bgRenderFileList();
}

async function bgPreviewAll() {
  if (!_bgFiles.length) return;
  _bgPreviews = [];
  _bgShowPhase(2);

  // Show loading cards
  const cardsEl = document.getElementById('bgPreviewCards');
  cardsEl.innerHTML = _bgFiles.map((f,i) => `
    <div id="bgCard${i}" class="border border-border-default rounded-xl overflow-hidden">
      <div class="px-4 py-3 bg-surface-subtle flex items-center gap-2">
        <span class="material-symbols-outlined spin text-accent text-base">progress_activity</span>
        <span class="text-sm font-medium truncate">${escHtml(f.name)}</span>
      </div>
    </div>`).join('');

  // Update summary defaults
  _bgUpdateSummary();

  // Preview each file — max 5 concurrent to avoid overloading backend
  await _bgRunThrottled(_bgFiles, (f, i) => _bgPreviewFile(f, i), 5);
  _bgUpdateSummary();
}

async function _bgPreviewFile(file, idx) {
  const cardEl = document.getElementById(`bgCard${idx}`);
  const fd = new FormData();
  fd.append('file', file);
  let preview = null;
  let errMsg = null;
  try {
    const res = await fetch(`${API_BASE}/grades/preview`, {
      method: 'POST', headers: { Authorization: `Bearer ${token}` }, body: fd,
    });
    const data = await res.json();
    if (res.ok) { preview = data; }
    else { errMsg = data?.detail || 'Lỗi preview'; }
  } catch(e) { errMsg = 'Lỗi kết nối: ' + e.message; }

  _bgPreviews[idx] = preview;

  if (preview) {
    const sv = preview.student_code ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 bg-accent-soft text-indigo-700 text-xs font-bold rounded-full"><span class="material-symbols-outlined text-xs">badge</span>${escHtml(preview.student_code)}</span>` : `<span class="text-xs text-warning font-semibold">⚠ Không đọc được mã SV</span>`;
    const tc = preview.tich_luy != null ? `<span class="text-xs text-text-tertiary">${preview.tich_luy} TC tích lũy</span>` : '';
    cardEl.innerHTML = `
      <div class="px-4 py-3 bg-surface-subtle flex flex-wrap items-center gap-2 border-b border-border-subtle">
        <span class="material-symbols-outlined text-success text-base flex-shrink-0" style="font-variation-settings:'FILL' 1">check_circle</span>
        <span class="text-sm font-medium flex-1 min-w-0 truncate">${escHtml(file.name)}</span>
        ${sv}
        <button onclick="_bgRemoveByIdx(${idx})"
          class="p-1 text-text-tertiary hover:text-danger transition-colors flex-shrink-0" title="Bỏ qua file này">
          <span class="material-symbols-outlined text-base">close</span>
        </button>
      </div>
      <div class="px-4 py-3 flex flex-wrap items-center gap-4 text-sm">
        <span class="text-success font-semibold"><strong>${preview.matched.length}</strong> môn khớp</span>
        ${preview.unmatched.length ? `<button onclick="_bgShowUnmatched(${idx})" class="text-warning font-semibold underline decoration-dashed cursor-pointer hover:text-warning transition-colors bg-transparent border-0 p-0"><strong>${preview.unmatched.length}</strong> môn lạ</button>` : ''}
        ${tc}
        <span class="text-xs text-text-tertiary">${preview.total_rows_in_file} dòng trong file</span>
        <button onclick="_bgOpenDetail(${idx})"
          class="ml-auto flex items-center gap-1 px-3 py-1 text-xs font-semibold text-accent border border-indigo-200 rounded-lg hover:bg-accent-soft transition-colors flex-shrink-0">
          <span class="material-symbols-outlined text-sm">table_view</span>Xem chi tiết
        </button>
      </div>`;
  } else {
    cardEl.innerHTML = `
      <div class="px-4 py-3 bg-danger-soft flex items-center gap-2">
        <span class="material-symbols-outlined text-danger text-base flex-shrink-0">error</span>
        <span class="text-sm font-medium truncate flex-1">${escHtml(file.name)}</span>
        <span class="text-xs text-danger">${escHtml(errMsg)}</span>
      </div>`;
  }
}

function _bgUpdateSummary() {
  const activeFiles = _bgFiles.filter(Boolean);
  const previewed   = _bgPreviews.filter(Boolean);

  // Top status bar
  document.getElementById('bgSumFiles').textContent        = activeFiles.length;
  document.getElementById('bgSumStudents').textContent     = previewed.filter(p => p.student_code).length;
  document.getElementById('bgSumMatched').textContent      = previewed.reduce((s,p) => s + (p?.matched?.length||0), 0);
  document.getElementById('bgSumUnmatchedBar').textContent = previewed.reduce((s,p) => s + (p?.unmatched?.length||0), 0);

  // Detail summary box
  const box = document.getElementById('bgPhase2Summary');
  if (!box) return;
  if (!activeFiles.length) { box.classList.add('hidden'); return; }

  const newCount       = previewed.filter(p => p.account_created === true).length;
  const updateCount    = previewed.filter(p => p.account_created === false).length;
  const unmatchedTotal = previewed.reduce((s,p) => s + (p?.unmatched?.length||0), 0);
  const errorCount     = activeFiles.length - previewed.length;
  const creditsTotal   = previewed.reduce((s,p) => s + (p?.tich_luy||0), 0);
  const specChanges    = previewed.filter(p => p.specialization_changed && p.new_specialization);

  const setText = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
  setText('bgSumNew',       newCount);
  setText('bgSumUpdate',    updateCount);
  setText('bgSumSpec',      specChanges.length);
  setText('bgSumUnmatched', unmatchedTotal);
  setText('bgSumErrors',    errorCount);
  setText('bgSumCredits',   creditsTotal % 1 === 0 ? creditsTotal : creditsTotal.toFixed(1));

  // Spec-change detail list
  const specDetail = document.getElementById('bgSumSpecDetail');
  const specList   = document.getElementById('bgSumSpecList');
  if (specChanges.length > 0 && specList) {
    specDetail?.classList.remove('hidden');
    specList.innerHTML = specChanges.map(p =>
      `<div>• <strong>${escHtml(p.student_code)}</strong>: ${escHtml(p.old_specialization || 'Chưa có')} → <span class="font-semibold text-violet-700">${escHtml(p.new_specialization)}</span></div>`
    ).join('');
  } else {
    specDetail?.classList.add('hidden');
  }

  box.classList.remove('hidden');
}

function _bgRemoveByIdx(idx) {
  // Đánh dấu bỏ qua — set preview null và ẩn card
  _bgPreviews[idx] = null;
  _bgFiles[idx] = null;
  const card = document.getElementById(`bgCard${idx}`);
  if (card) card.classList.add('hidden');
  _bgUpdateSummary();
}

function _bgShowUnmatched(idx) {
  const preview = _bgPreviews[idx];
  const file    = _bgFiles[idx];
  if (!preview) return;
  const unmatched = preview.unmatched || [];
  const modal = document.getElementById('modalBgDetail');
  document.getElementById('bgDetailTitle').textContent = 'Môn không có trong CTĐT';
  document.getElementById('bgDetailSub').textContent =
    `${file ? file.name : ''} · ${unmatched.length} môn lạ · Sẽ được lưu nhưng KHÔNG tính vào tiến độ TC`;

  let html = `<div class="mb-3 bg-warning-soft border border-amber-200 rounded-lg px-4 py-2.5 text-sm text-amber-800">
    Các môn dưới đây <strong>sẽ được import và lưu vào CSDL</strong>, nhưng <strong>không tính vào tín chỉ tích lũy</strong> vì không có trong CTĐT.
  </div>
  <div class="rounded-xl overflow-hidden border border-border-default">
    <table class="w-full text-xs">
      <thead><tr class="bg-surface-subtle text-text-secondary border-b border-border-default">
        <th class="px-3 py-2 text-left font-semibold">Mã môn (trong file)</th>
        <th class="px-3 py-2 text-left font-semibold">Tên môn (trong file)</th>
        <th class="px-3 py-2 text-left font-semibold">Lý do</th>
      </tr></thead>
