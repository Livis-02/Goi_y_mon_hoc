  // Missing teachers
  const missSec = document.getElementById('iaMissingSection');
  if (data.missing_teachers?.length) {
    missSec.classList.remove('hidden');
    document.getElementById('iaMissingTable').innerHTML = data.missing_teachers.map(m =>
      `<tr class="border-b border-amber-100">
        <td class="py-1 font-mono text-amber-800">${escHtml(m.teacher_code)}</td>
        <td class="py-1 text-center text-warning">${m.student_count} SV</td>
      </tr>`
    ).join('');
    // Reset radio
    document.querySelector('input[name="iaMissingChoice"][value="skip"]').checked = true;
    document.getElementById('iaNewTeacherForms').classList.add('hidden');
    document.getElementById('iaNewTeacherForms').innerHTML = '';
  } else {
    missSec.classList.add('hidden');
  }

  // Errors
  const errSec = document.getElementById('iaPreviewErrors');
  if (data.errors?.length) {
    errSec.classList.remove('hidden');
    document.getElementById('iaPreviewErrorList').innerHTML = data.errors.map(e =>
      `<li>Dòng ${e.row}: ${escHtml(e.reason)}</li>`
    ).join('');
  } else {
    errSec.classList.add('hidden');
  }
}

function iaMissingChoiceChange() {
  const choice = document.querySelector('input[name="iaMissingChoice"]:checked')?.value;
  const formsEl = document.getElementById('iaNewTeacherForms');
  if (choice === 'create' && _iaPreviewData?.missing_teachers?.length) {
    formsEl.classList.remove('hidden');
    formsEl.innerHTML = _iaPreviewData.missing_teachers.map(m => `
      <div class="border border-border-default rounded-xl p-4 space-y-3" data-tc="${escHtml(m.teacher_code)}">
        <div class="flex items-center gap-2">
          <span class="font-mono text-sm font-bold text-violet-700">${escHtml(m.teacher_code)}</span>
          <span class="text-xs text-text-tertiary">(${m.student_count} SV)</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <input autocomplete="off" type="text" data-field="full_name" placeholder="Họ tên (bắt buộc)"
            class="border border-border-default rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-violet-300"
            onblur="this.value=normViName(this.value)"/>
          <select autocomplete="off" data-field="managed_specialization" class="border border-border-default rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-violet-300">
            ${_IA_SPEC_OPTS}
          </select>
        </div>
      </div>`).join('');
  } else {
    formsEl.classList.add('hidden');
    formsEl.innerHTML = '';
  }
}

function _iaCollectNewTeachers() {
  const forms = document.querySelectorAll('#iaNewTeacherForms [data-tc]');
  const result = [];
  for (const form of forms) {
    const tc = form.dataset.tc;
    const fn = form.querySelector('[data-field="full_name"]').value.trim();
    const spec = form.querySelector('[data-field="managed_specialization"]').value;
    if (!fn) { toast(`Vui lòng nhập họ tên cho ${tc}`, false); return null; }
    result.push({ teacher_code: tc, full_name: fn, managed_specialization: spec || null });
  }
  return result;
}

async function iaStep2Submit() {
  const choice = document.querySelector('input[name="iaMissingChoice"]:checked')?.value;
  const autoCreate = choice === 'create';
  let newTeachers = [];
  if (autoCreate) {
    newTeachers = _iaCollectNewTeachers();
    if (newTeachers === null) return; // validation failed
  }

  const btn = document.getElementById('iaSubmitBtn');
  btn.disabled = true; btn.textContent = 'Đang xử lý...';
  try {
    const fd = new FormData();
    fd.append('file', _iaFile);
    fd.append('dry_run', 'false');
    fd.append('auto_create', autoCreate ? 'true' : 'false');
    fd.append('new_teachers_json', JSON.stringify(newTeachers));
    const res = await fetch(API_BASE + '/admin/assignments/bulk-import', {
      method: 'POST', headers: auth(), body: fd,
    });
    const data = await res.json();
    if (!res.ok) { toast(data.detail || 'Lỗi xử lý', false); return; }
    _iaRenderResult(data);
    _iaGoStep(3);
  } catch(e) {
    toast('Lỗi: ' + e.message, false);
  } finally {
    btn.disabled = false; btn.textContent = 'Xử lý';
  }
}

function _iaRenderResult(data) {
  document.getElementById('iaResultSummary').innerHTML =
    _iaSummaryChip(data.created, 'Phân công mới', 'violet') +
    _iaSummaryChip(data.updated, 'Đã cập nhật', 'blue') +
    _iaSummaryChip(data.skipped + (data.errors?.length||0), 'Bỏ qua / Lỗi', 'slate');

  // Created teachers
  const ctEl = document.getElementById('iaCreatedTeachers');
  if (data.created_teachers?.length) {
    ctEl.classList.remove('hidden');
    document.getElementById('iaCreatedTeachersList').innerHTML = data.created_teachers.map(t =>
      `<div class="flex items-center justify-between py-0.5">
        <span><strong>${escHtml(t.teacher_code)}</strong> — ${escHtml(t.full_name)}</span>
        <span class="text-warning font-mono">${escHtml(t.password_plain)}
          <button onclick="navigator.clipboard.writeText('${escHtml(t.password_plain)}').then(()=>toast('Đã copy'))"
            class="ml-1 text-text-tertiary hover:text-accent align-middle" title="Copy">
            <span class="material-symbols-outlined text-xs" style="font-size:14px">content_copy</span>
          </button>
        </span>
      </div>`
    ).join('');
  } else {
    ctEl.classList.add('hidden');
  }

  // Errors
  const errEl = document.getElementById('iaResultErrors');
  if (data.errors?.length) {
    errEl.classList.remove('hidden');
    document.getElementById('iaResultErrorList').innerHTML = data.errors.map(e =>
      `<li>Dòng ${e.row}: ${escHtml(e.reason)}</li>`
    ).join('');
  } else {
    errEl.classList.add('hidden');
  }
}

function iaStep2Back() { _iaGoStep(1); }
</script>

<!-- ── Modal chuyển chức GVCN ────────────────────────────────────── -->
<div id="modalTransferHead" class="hidden fixed inset-0 bg-black/50 z-[9500] items-center justify-center p-4">
  <div class="bg-surface rounded-2xl shadow-xl w-full max-w-md">
    <div class="flex items-center justify-between px-6 py-4 border-b border-border-subtle">
      <h3 class="font-bold text-text-primary">Chuyển chức GVCN</h3>
      <button onclick="closeTransferHeadModal()" class="text-text-tertiary hover:text-text-secondary">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div class="px-6 py-5 space-y-4">
      <p class="text-sm text-text-secondary">
        Chọn cố vấn trong cùng chuyên ngành để trở thành GVCN mới.
        GVCN hiện tại sẽ được chuyển về thành viên thường.
      </p>
      <div id="transferHeadNoOneMsg" class="hidden bg-warning-soft border border-amber-200 rounded-lg px-4 py-3 text-sm text-warning">
        Không có ai trong chuyên ngành để chuyển chức. Tạo advisor mới trước.
      </div>
      <div id="transferHeadSelectWrap">
        <label class="block text-xs font-semibold text-text-tertiary mb-1">GVCN mới</label>
        <select autocomplete="off" id="transferHeadSel"
          class="w-full border border-border-default rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
        </select>
      </div>
    </div>
    <div class="flex justify-end gap-3 px-6 py-4 border-t border-border-subtle">
      <button onclick="closeTransferHeadModal()" class="text-sm text-text-tertiary hover:underline px-3 py-2">Huỷ</button>
      <button id="btnTransferHeadConfirm" onclick="submitTransferHead()"
        class="px-5 py-2 bg-amber-600 text-white text-sm font-bold rounded-lg hover:bg-amber-700 active:scale-95 transition-all">
        Xác nhận chuyển chức
      </button>
    </div>
  </div>
</div>

<script>
let _transferFromId = null;

function openTransferHeadModal() {
  const advisorId = parseInt(document.getElementById('editAdvisorId').value);
  const adv = _advisorsList.find(a => a.id === advisorId);
  if (!adv) return;
  _transferFromId = advisorId;
  const spec = adv.managed_specialization || '';
  const peers = _advisorsList.filter(a => a.id !== advisorId && (a.managed_specialization || '') === spec);
  const noOneEl = document.getElementById('transferHeadNoOneMsg');
  const selWrap = document.getElementById('transferHeadSelectWrap');
  const confirmBtn = document.getElementById('btnTransferHeadConfirm');
  if (!peers.length) {
    noOneEl.classList.remove('hidden');
    selWrap.classList.add('hidden');
    confirmBtn.disabled = true;
    confirmBtn.classList.add('opacity-50', 'cursor-not-allowed');
  } else {
    noOneEl.classList.add('hidden');
    selWrap.classList.remove('hidden');
    confirmBtn.disabled = false;
    confirmBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    const sel = document.getElementById('transferHeadSel');
    sel.innerHTML = peers.map(p =>
      `<option value="${p.id}">${escHtml(p.full_name || p.username)} (${escHtml(p.teacher_code || p.username)})</option>`
    ).join('');
  }
  const modal = document.getElementById('modalTransferHead');
  modal.classList.remove('hidden');
  modal.style.display = 'flex';
}

function closeTransferHeadModal() {
  const modal = document.getElementById('modalTransferHead');
  modal.style.display = 'none';
  modal.classList.add('hidden');
  _transferFromId = null;
}

async function submitTransferHead() {
  if (!_transferFromId) return;
  const newId = parseInt(document.getElementById('transferHeadSel').value);
  if (!newId) return;
  const res = await callApi(`/admin/advisors/${_transferFromId}/transfer-head`, {
    method: 'POST',
    headers: { ...auth(), 'Content-Type': 'application/json' },
    body: JSON.stringify({ new_head_advisor_id: newId }),
  });
  if (res.ok) {
    toast(res.data?.message || 'Đã chuyển chức GVCN thành công');
    closeTransferHeadModal();
    closeEditAdvisorPanel();
    loadAdvisorsList();
  } else {
    toast(res.data?.detail || 'Lỗi chuyển chức', false);
  }
}
</script>

