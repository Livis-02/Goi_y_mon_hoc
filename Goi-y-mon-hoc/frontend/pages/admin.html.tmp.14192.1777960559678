  modal.id = modalId;
  modal.className = 'fixed inset-0 bg-black/50 z-[950] flex items-center justify-center p-4';
  modal.innerHTML = `
    <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-md max-h-[90vh] flex flex-col">
      <div class="px-5 py-4 border-b border-border-subtle flex items-start gap-3">
        <div class="w-10 h-10 rounded-full bg-danger-soft flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-danger">warning</span>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="font-bold text-text-primary">Xóa cố vấn ${escHtml(adv.full_name || adv.username)}</h3>
          <p class="text-xs text-text-tertiary mt-0.5">${subtitle}</p>
        </div>
        <button onclick="document.getElementById('${modalId}').remove()"
          class="text-text-tertiary hover:text-text-secondary flex-shrink-0">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="px-5 py-4 flex-1 overflow-y-auto">
        <p class="text-xs font-bold text-text-secondary mb-2 uppercase tracking-wider">
          Chọn cố vấn kế nhiệm <span class="text-danger">*</span>
          <span class="font-normal text-text-tertiary normal-case tracking-normal">
            (cùng chuyên ngành ${escHtml(specLabel)})
          </span>
        </p>
        <div class="space-y-1.5" id="advTransferList">${items}</div>
        <div id="advTransferErr" class="hidden mt-2 text-xs text-danger"></div>
      </div>
      <div class="px-5 py-3 border-t border-border-subtle flex justify-end gap-2 flex-shrink-0">
        <button onclick="document.getElementById('${modalId}').remove()"
          class="px-4 py-2 text-sm text-text-secondary hover:bg-surface-strong rounded-lg transition-colors">Hủy</button>
        <button onclick="_submitTransferDelete(${adv.id}, '${escHtml(adv.username)}')"
          class="px-4 py-2 bg-red-600 text-white text-sm font-bold rounded-lg hover:bg-red-700 transition-colors flex items-center gap-1.5">
