async function submitCreateUser() {
  const code  = document.getElementById('createUserCode').value.trim();
  const name  = document.getElementById('createUserName').value.trim();
  const cohort = _getActiveCohort();
  const errEl = document.getElementById('createUserError');
  errEl.classList.add('hidden');

  if (!cohort) { errEl.textContent = 'Vui lòng chọn hoặc nhập khóa.'; errEl.classList.remove('hidden'); return; }
  if (!/^\d{2}$/.test(cohort)) { errEl.textContent = 'Khóa phải là 2 chữ số.'; errEl.classList.remove('hidden'); return; }
  if (!code) { errEl.textContent = 'Vui lòng nhập mã sinh viên.'; errEl.classList.remove('hidden'); return; }
  if (!name) { errEl.textContent = 'Vui lòng nhập họ tên sinh viên.'; errEl.classList.remove('hidden'); return; }
  // Format demo: sv14001 (sv + 2 số khoá + 3 số STT). Backward compat: cho phép
  // format cũ 10 số (1400000001) và SV+6 số (SV140001) nếu admin đã có data.
  const m = /^(sv|)(\d{2})(\d{3,8})$/i.exec(code);
  if (!m) {
    errEl.textContent = 'Mã SV không hợp lệ. Format chuẩn: sv14001 (sv + 2 số khoá + 3 số STT).';
    errEl.classList.remove('hidden'); return;
  }
  if (m[2] !== cohort) {
    errEl.textContent = `Mã SV phải có 2 số khoá là ${cohort} (K${cohort}). VD: sv${cohort}001.`;
    errEl.classList.remove('hidden'); return;
  }

  const btn = document.getElementById('createUserBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> Đang tạo...';

  const res = await callApi('/admin/users', {
    method: 'POST',
    headers: { ...auth(), 'Content-Type': 'application/json' },
    body: JSON.stringify({ username: code, full_name: name || code, role: 'student' }),
  });

  btn.disabled = false;
  btn.textContent = 'Tạo tài khoản';

  if (res.ok) {
    const pw = res.data.password_plain;
    const displayName = name || code;
    // Switch to result state
    document.getElementById('resultCode').textContent = code;
    document.getElementById('resultName').textContent = displayName;
    document.getElementById('resultCohort').textContent = `K${cohort}`;
    document.getElementById('resultPw').textContent = pw;
    document.getElementById('resultCopyBtn').onclick = () =>
      navigator.clipboard.writeText(pw).then(() => toast('Đã copy mật khẩu'));
    document.getElementById('createUserForm').classList.add('hidden');
    document.getElementById('createUserResult').classList.remove('hidden');
    document.getElementById('createUserFooterForm').classList.add('hidden');
    document.getElementById('createUserFooterResult').classList.remove('hidden');
    // Also toast for convenience
    toast(`Đã tạo <strong>${escHtml(displayName)}</strong> — MK: <strong class="font-mono">${escHtml(pw)}</strong> <button onclick="navigator.clipboard.writeText('${pw}').then(()=>toast('Đã copy'))" class="underline text-indigo-300 ml-1">Copy</button>`, true, 8000);
    // Refresh data silently
    loadUsersTab();
  } else {
    errEl.textContent = res.data?.detail || 'Lỗi tạo tài khoản.';
    errEl.classList.remove('hidden');
  }
}

