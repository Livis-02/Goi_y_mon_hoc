function showPwPopup(btn, pw) {
  document.querySelectorAll('.pw-popup').forEach(e => e.remove());
  const popup = document.createElement('div');
  popup.className = 'pw-popup fixed z-[9999] bg-surface border border-amber-200 rounded-xl shadow-xl p-3 text-left min-w-[170px]';
  popup.innerHTML = `
    <p class="text-[10px] text-text-tertiary mb-1 uppercase tracking-wide">Mật khẩu mặc định</p>
    <p class="font-mono font-bold text-xl text-warning tracking-widest mb-2">${escHtml(pw)}</p>
    <button onclick="navigator.clipboard.writeText('${pw}').then(()=>{toast('Đã copy mật khẩu');document.querySelectorAll('.pw-popup').forEach(e=>e.remove())})"
      class="w-full text-xs bg-warning-soft text-warning rounded-lg px-2 py-1.5 hover:bg-amber-200 transition-colors inline-flex items-center justify-center gap-1">
      <span class="material-symbols-outlined text-sm">content_copy</span>Copy
    </button>`;
  document.body.appendChild(popup);
  const rect = btn.getBoundingClientRect();
  const popW = 170;
  let left = rect.right - popW;
  if (left < 8) left = 8;
  popup.style.top  = (rect.bottom + 4) + 'px';
  popup.style.left = left + 'px';
  setTimeout(() => {
    function handler(e) {
      if (!popup.contains(e.target) && e.target !== btn) { popup.remove(); document.removeEventListener('click', handler); }
    }
    document.addEventListener('click', handler);
  }, 0);
}

