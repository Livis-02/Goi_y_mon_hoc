function deleteAdvisor(advisorId, username) {
  const adv = _advisorsList.find(a => a.id === advisorId);
  if (!adv) { toast('Không tìm thấy cố vấn', false); return; }

  const sameSpecOthers = _advisorsList.filter(a =>
    a.id !== advisorId && (a.managed_specialization || '') === (adv.managed_specialization || '')
  );
  const studentCount = adv.student_count || 0;
  const isHead = false;  // Bỏ — không còn distinguish
  const specLabel = _SPEC_FULL[adv.managed_specialization || ''] || (adv.managed_specialization ? adv.managed_specialization : 'Đại cương');

  // Quy tắc: chỉ cần modal chuyển giao khi có thứ phải chuyển:
  //   - Đây là GVCN (cần chuyển chức trưởng), HOẶC
  //   - Có SV phụ trách (cần chuyển SV cho người khác)
  // GV thường không có SV → xóa thẳng với confirm đơn giản.
  const needsTransfer = (isHead || studentCount > 0) && sameSpecOthers.length > 0;

  if (!needsTransfer) {
    // Confirm xóa đơn giản (GV bình thường, không có SV, không phải trưởng)
    let warn = `<p>Xóa cố vấn <strong>${escHtml(adv.full_name || username)}</strong> (${escHtml(username)})?</p>`;
    if (sameSpecOthers.length === 0) {
      warn += `<p class="mt-2 text-xs text-warning bg-warning-soft border border-amber-200 rounded-lg p-2">
        <strong>Cảnh báo:</strong> Đây là cố vấn duy nhất của chuyên ngành ${escHtml(specLabel)}.
        Sau khi xóa, chuyên ngành sẽ không còn cố vấn nào.</p>`;
      if (studentCount > 0) {
        warn += `<p class="mt-2 text-xs text-danger bg-danger-soft border border-danger rounded-lg p-2">
          <strong>${studentCount} sinh viên</strong> phụ trách sẽ trở thành chưa có cố vấn.
          Bạn cần phân công lại bằng "Phân loại tự động" hoặc thủ công.</p>`;
      }
    } else {
      warn += `<p class="mt-2 text-xs text-text-tertiary">Chuyên ngành ${escHtml(specLabel)} còn ${sameSpecOthers.length} cố vấn khác hoạt động bình thường.</p>`;
    }
    _confirm(warn, async () => {
      const res = await callApi(`/admin/advisors/${advisorId}`, { method: 'DELETE', headers: auth() });
      if (res.ok) {
        toast(res.data.message || 'Đã xóa cố vấn');
        if (_activeAdvisorId === advisorId) closeAssignPanel();
        loadAdvisorsList();
      } else toast(res.data?.detail || 'Lỗi xóa cố vấn', false);
    }, 'Xóa cố vấn');
    return;
  }

  // Cần chuyển giao (là trưởng hoặc có SV) → mở modal chọn kế nhiệm
  _openTransferDeleteModal(adv, sameSpecOthers, specLabel, studentCount, isHead);
}

