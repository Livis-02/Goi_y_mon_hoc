function _renderAdvSvListBody(advisorId) {
  const body = document.getElementById('_advSvListBody');
  if (!body) return;
  const list = _advisorStudentsCache[advisorId] || [];
  if (!list.length) {
    body.innerHTML = '<p class="text-sm text-text-tertiary italic py-8 text-center">Chưa có sinh viên nào được phân công.</p>';
    return;
  }
  const q = (document.getElementById('_advSvListSearch')?.value || '').toLowerCase().trim();
  const cohortFil = document.getElementById('_advSvListCohortFilter')?.value || '';

  // Filter + group
  const groups = {};
  for (const s of list) {
    const cohort = _cohortFromUsername(s.username) || '__other__';
    if (cohortFil && cohort !== cohortFil) continue;
    if (q) {
      const hay = `${s.username || ''} ${s.full_name || ''}`.toLowerCase();
      if (!hay.includes(q)) continue;
    }
    (groups[cohort] = groups[cohort] || []).push(s);
  }
  const cohorts = Object.keys(groups).sort((a, b) => {
    if (a === '__other__') return 1;
    if (b === '__other__') return -1;
    return b.localeCompare(a);
  });
  if (!cohorts.length) {
    body.innerHTML = '<p class="text-sm text-text-tertiary italic py-8 text-center">Không có sinh viên phù hợp bộ lọc.</p>';
    return;
  }

  body.innerHTML = cohorts.map(c => {
    const all = groups[c].slice().sort((a, b) => (a.username || '').localeCompare(b.username || ''));
    const limit = _advSvListLimit[`${advisorId}_${c}`] || _ADV_SV_PAGE_STEP;
    const visible = all.slice(0, limit);
    const more = all.length - visible.length;
    const label = c === '__other__' ? 'Khác' : `Khóa K${c}`;
    return `
      <section>
        <div class="flex items-center justify-between mb-1.5 px-1">
          <p class="text-xs font-bold text-text-secondary uppercase tracking-wider">
            ${escHtml(label)} <span class="font-normal normal-case text-text-tertiary">· ${all.length} SV</span>
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-1.5">
          ${visible.map(s => {
            const init = (s.full_name || s.username || '?').split(' ').slice(-2).map(w => w[0] || '').join('').toUpperCase().slice(0, 2);
            return `<button onclick="_openSvFromAdvisor(${s.student_id})"
              class="flex items-center gap-2 bg-surface border border-border-default rounded-lg px-2.5 py-2 hover:border-indigo-300 hover:bg-accent-soft/30 transition text-left min-w-0">
              <div class="w-7 h-7 rounded-full bg-surface-strong flex items-center justify-center text-[11px] font-bold text-text-secondary flex-shrink-0">${init}</div>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold text-text-primary truncate leading-tight">${escHtml(s.full_name || s.username)}</p>
                <p class="font-mono text-[10px] text-text-tertiary truncate leading-tight">${escHtml(s.username)}</p>
              </div>
            </button>`;
          }).join('')}
        </div>
        ${more > 0 ? `
          <button onclick="_advSvListLoadMore(${advisorId}, '${escHtml(c)}')"
            class="mt-2 w-full text-xs text-accent hover:bg-accent-soft rounded-md py-1.5 transition-colors">
            Xem thêm ${more} SV…
          </button>
        ` : ''}
      </section>`;
  }).join('');
}

function _advSvListLoadMore(advisorId, cohort) {
  const key = `${advisorId}_${cohort}`;
  _advSvListLimit[key] = (_advSvListLimit[key] || _ADV_SV_PAGE_STEP) + _ADV_SV_PAGE_STEP;
  _renderAdvSvListBody(advisorId);
}

