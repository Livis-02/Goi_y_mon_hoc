async function _listUpdateSemester(code, val) {
  const sem = (!val || val === '0' || val === 0) ? null : parseInt(val);
  const res = await callApi(`/admin/courses/${encodeURIComponent(code)}/semester`, {
    method: 'PATCH', headers: auth(), body: JSON.stringify({ semester: sem }),
  });
  if (!res.ok) {
    const msg = res.data?.detail || res.data?.message || `HTTP ${res.status}`;
    toast(`Lỗi cập nhật học kỳ: ${msg}`, false);
    return;
  }
  const data = _crsDataCache[_crsSpec];
  if (data) {
    for (const arr of [data.compulsory, data.elective_a?.courses, data.elective_b?.courses, data.elective_c?.courses]) {
      const c = arr?.find(x => x.course_code === code);
      if (c) { c.typical_semester = sem; break; }
    }
  }
  toast('Đã cập nhật học kỳ');
  applyCrsFilter();
}

function _toggleHkEdit(_code, btn) {
  // Close any other open popup first
  document.querySelectorAll('.hk-edit-pop').forEach(p => {
    if (p !== btn.parentElement.querySelector('.hk-edit-pop')) p.classList.add('hidden');
  });
  const pop = btn.parentElement.querySelector('.hk-edit-pop');
  if (pop) pop.classList.toggle('hidden');
}

function _closeHkEdit() {
  document.querySelectorAll('.hk-edit-pop').forEach(p => p.classList.add('hidden'));
}

// Close HK edit popup on outside click
document.addEventListener('click', (e) => {
  if (!e.target.closest('.hk-edit-pop') && !e.target.closest('[onclick^="_toggleHkEdit"]')) {
    _closeHkEdit();
  }
});

async function _listRemovePrereq(code, prereqCode) {
  const res = await callApi(`/admin/prerequisites/${encodeURIComponent(code)}/${encodeURIComponent(prereqCode)}`, {
    method: 'DELETE', headers: auth(),
  });
  if (!res.ok) {
    const msg = res.data?.detail || res.data?.message || `HTTP ${res.status}`;
    toast(`Không xoá được tiên quyết "${prereqCode}": ${msg}`, false);
    return;
  }
  const data = _crsDataCache[_crsSpec];
  if (data) {
    for (const arr of [data.compulsory, data.elective_a?.courses, data.elective_b?.courses, data.elective_c?.courses]) {
      const c = arr?.find(x => x.course_code === code);
      if (c) { c.prereqs = (c.prereqs || []).filter(p => p !== prereqCode); break; }
    }
  }
  toast('Đã xóa tiên quyết');
  applyCrsFilter();
}

function _listAddPrereq(code, btnEl) {
  if (_listPrereqDropClose) { _listPrereqDropClose(); _listPrereqDropClose = null; }

  const data = _crsDataCache[_crsSpec];
  const allCrs = [
    ...(data?.compulsory || []),
    ...(data?.elective_a?.courses || []),
    ...(data?.elective_b?.courses || []),
    ...(data?.elective_c?.courses || []),
  ];
  const existing = new Set(allCrs.find(x => x.course_code === code)?.prereqs || []);
  const available = allCrs.filter(c => c.course_code !== code && !existing.has(c.course_code));

  const dropdown = document.createElement('div');
  dropdown.className = 'absolute z-50 bg-surface border border-border-default rounded-xl shadow-xl p-2';
  dropdown.style.cssText = 'top:calc(100% + 4px);left:0;min-width:260px;max-width:90vw';

  const input = document.createElement('input');
  input.type = 'text';
  input.placeholder = 'Tìm mã hoặc tên môn…';
  input.className = 'w-full border border-border-default rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500/20 mb-1.5';

  const list = document.createElement('div');
  list.className = 'max-h-44 overflow-y-auto';

  dropdown.appendChild(input);
  dropdown.appendChild(list);

  function renderList(q) {
    const items = q
      ? available.filter(c => (c.course_code + ' ' + c.course_name).toLowerCase().includes(q.toLowerCase())).slice(0, 30)
      : available.slice(0, 20);
    list.innerHTML = items.length
      ? items.map(c => `<button data-code="${escHtml(c.course_code)}"
          class="w-full text-left px-2 py-1.5 hover:bg-accent-soft rounded-lg flex items-center gap-2 text-xs">
          <span class="font-mono text-indigo-700 font-bold flex-shrink-0">${escHtml(c.course_code)}</span>
          <span class="text-text-secondary truncate">${escHtml(c.course_name)}</span>
        </button>`).join('')
      : '<div class="text-xs text-text-tertiary py-2 text-center">Không tìm thấy</div>';
    list.querySelectorAll('button[data-code]').forEach(btn => {
      btn.addEventListener('click', () => _listAddPrereqConfirm(code, btn.dataset.code));
    });
  }
  renderList('');
  input.addEventListener('input', () => renderList(input.value));

  const wrapper = document.createElement('div');
  wrapper.style.cssText = 'position:relative;display:inline-block';
  btnEl.after(wrapper);
  wrapper.appendChild(dropdown);
  _listPrereqDropClose = () => wrapper.remove();

  setTimeout(() => {
    document.addEventListener('click', function handler(e) {
      if (!dropdown.contains(e.target) && e.target !== btnEl) {
        _listPrereqDropClose?.(); _listPrereqDropClose = null;
        document.removeEventListener('click', handler);
      }
    });
  }, 50);
  input.focus();
}

async function _listAddPrereqConfirm(courseCode, prereqCode) {
  if (_listPrereqDropClose) { _listPrereqDropClose(); _listPrereqDropClose = null; }
  const res = await callApi('/admin/prerequisites', {
    method: 'POST', headers: auth(),
    body: JSON.stringify({ course_code: courseCode, prerequisite_code: prereqCode }),
  });
  if (!res.ok) { toast(extractError(res.data) || 'Lỗi thêm tiên quyết', false); return; }
  const data = _crsDataCache[_crsSpec];
  if (data) {
    for (const arr of [data.compulsory, data.elective_a?.courses, data.elective_b?.courses, data.elective_c?.courses]) {
      const c = arr?.find(x => x.course_code === courseCode);
      if (c) { c.prereqs = [...(c.prereqs || []), prereqCode]; break; }
    }
  }
  toast('Đã thêm tiên quyết');
  applyCrsFilter();
}

