function _renderNfPagination(total, pageSize, totalPages) {
  const wrap = document.getElementById('nfPagination');
  if (!wrap) return;
  if (total <= pageSize) { wrap.classList.add('hidden'); return; }
  wrap.classList.remove('hidden');
  const ctrl = document.getElementById('nfPageControls');
  const range = (a,b) => { const r=[]; for (let i=a;i<=b;i++) r.push(i); return r; };
  const btnCls = (active) => `px-2.5 py-1 rounded-md font-semibold transition-colors ${active ? 'bg-indigo-600 text-white' : 'bg-surface-subtle text-text-secondary hover:bg-surface-strong'}`;
  let html = `<button onclick="_nfPage=Math.max(1,_nfPage-1);applyNotifFilter()" ${_nfPage===1?'disabled':''} class="${btnCls(false)}">&#8249;</button>`;
  let pages;
  if (totalPages <= 7) pages = range(1, totalPages);
  else if (_nfPage <= 4) pages = [...range(1,5), -1, totalPages];
  else if (_nfPage >= totalPages-3) pages = [1, -1, ...range(totalPages-4, totalPages)];
  else pages = [1, -1, ...[_nfPage-1,_nfPage,_nfPage+1], -1, totalPages];
  for (const p of pages) {
    if (p === -1) html += `<span class="px-1 text-text-tertiary">…</span>`;
    else html += `<button onclick="_nfPage=${p};applyNotifFilter()" class="${btnCls(p===_nfPage)}">${p}</button>`;
  }
  html += `<button onclick="_nfPage=Math.min(${totalPages},_nfPage+1);applyNotifFilter()" ${_nfPage===totalPages?'disabled':''} class="${btnCls(false)}">&#8250;</button>`;
  ctrl.innerHTML = html;
}

function _fmtTarget(tt, tv) {
  const base = _NF_TARGET_LABELS[tt] || tt || 'Toàn hệ thống';
  if (!tv) return base;
  const vals = tv.split(',').map(s => s.trim()).filter(Boolean);
  if (tt === 'cohort') return `SV khóa ${vals.join(', ')}`;
  if (tt === 'specialization') return `SV chuyên ngành ${vals.join(', ')}`;
  if (tt === 'students') return `${vals.length} SV cụ thể`;
  if (tt === 'advisors') return `${vals.length} cố vấn`;
  if (tt === 'department') return `CV chuyên ngành ${tv.trim()}`;
  return base;
}

function toggleNfMenu(id, btn) {
  const menu = document.getElementById('nf-menu-' + id);
  if (!menu) return;
  const wasHidden = menu.classList.contains('hidden');
  document.querySelectorAll('[id^="nf-menu-"]').forEach(m => m.classList.add('hidden'));
  if (wasHidden) {
    const rect = btn.getBoundingClientRect();
    menu.style.top = (rect.bottom + 4) + 'px';
    menu.style.right = (window.innerWidth - rect.right) + 'px';
    menu.classList.remove('hidden');
  }
}
document.addEventListener('click', function(e) {
  if (!e.target.closest('[id^="nf-menu-"]') && !e.target.closest('button[onclick*="toggleNfMenu"]')) {
    document.querySelectorAll('[id^="nf-menu-"]').forEach(m => m.classList.add('hidden'));
  }
});

