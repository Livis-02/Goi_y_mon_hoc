    ...(sd.compulsory || []),
    ...(sd.pool_b || []),
    ...(sd.pool_c || []),
  ];
}

// ── Kế hoạch chuẩn (read from DB → single source of truth for 3 roles) ──────
async function loadCrsPlan(spec) {
  const container = document.getElementById('crsPlanContainer');
  if (!container) return;
  // Update spec label in chart header
  const labelEl = document.getElementById('crsPlanSpecLabel');
  if (labelEl) {
    const lbl = _CRS_SPEC_LABEL[spec];
    labelEl.textContent = (spec && spec !== 'all' && lbl) ? '— ' + lbl : '';
  }
  // Clear placeholder/previous loading/error nodes (chừa SVG + cc-col cũ — initCurriculumChart sẽ tự dọn)
  container.querySelectorAll('._crs-plan-msg, #crsPlanInit').forEach(el => el.remove());

  // Loading state — gán class marker để remove trước render
  const loadingEl = document.createElement('div');
  loadingEl.className = '_crs-plan-msg flex items-center gap-3 py-10 px-6 text-sm text-text-tertiary';
  loadingEl.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span>Đang tải kế hoạch chuẩn…';
  container.appendChild(loadingEl);

  _crsPlanChart = initCurriculumChart(container, { canEdit: true, apiHeaders: auth(), callApi, toast, onRefresh: () => loadCrsPlan(spec) });

  if (!spec || spec === 'all') {
    container.querySelectorAll('._crs-plan-msg').forEach(el => el.remove());
    _crsPlanChart.render([]);
    return;
  }

  // Fetch standard plan from same API that student + advisor use.
  const res = await callApi(`/courses/standard-plan?spec=${encodeURIComponent(spec)}`, { headers: auth() });
  container.querySelectorAll('._crs-plan-msg').forEach(el => el.remove());
  if (!res.ok || !res.data?.semesters?.length) {
    const errEl = document.createElement('div');
    errEl.className = '_crs-plan-msg py-10 px-6 text-sm text-warning';
    errEl.textContent = 'Chưa có dữ liệu kế hoạch chuẩn cho chuyên ngành này. Cần import/khởi tạo courses.';
    container.appendChild(errEl);
    return;
  }
  const allCourses = [];
  for (const sem of res.data.semesters) {
    for (const c of sem.courses) {
      allCourses.push({
        course_code: c.course_code,
        course_name: c.course_name,
        credits: c.credits,
        count_toward_credits: c.count_toward_credits,
        typical_semester: sem.semester_number,
        group: c.group || 'compulsory',
        prereqs: c.prereqs || [],
        is_placeholder: !!c.is_placeholder,
      });
    }
  }
  _crsPlanChart.render(allCourses);
  document.getElementById('crsPlanHint')?.classList.remove('hidden');
  // Khôi phục trạng thái edit mode nếu trước đó đang BẬT
  if (_crsPlanEditOn) _crsPlanChart.setEditMode(true);
}

let _crsPlanEditOn = false;
function toggleCrsPlanEdit() {
  if (!_crsPlanChart) { toast('Chọn 1 chuyên ngành trước', false); return; }
  _crsPlanEditOn = !_crsPlanEditOn;
  _crsPlanChart.setEditMode(_crsPlanEditOn);
  const btn = document.getElementById('crsPlanEditBtn');
  const label = document.getElementById('crsPlanEditLabel');
  const hint = document.getElementById('crsPlanEditHint');
  if (_crsPlanEditOn) {
    btn?.classList.add('bg-indigo-600','text-white','border-indigo-600');
    btn?.classList.remove('bg-surface','text-text-secondary','border-border-default');
    if (label) label.textContent = 'Đang sửa · Click để tắt';
    hint?.classList.remove('hidden');
  } else {
    btn?.classList.remove('bg-indigo-600','text-white','border-indigo-600');
    btn?.classList.add('bg-surface','text-text-secondary','border-border-default');
    if (label) label.textContent = 'Chế độ sửa';
    hint?.classList.add('hidden');
  }
}

