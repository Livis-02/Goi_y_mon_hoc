function renderFilterOptions(users) {
  const cohortSel = document.getElementById('filterCohort');
  const prevCohort = cohortSel.value;
  const cohorts = [...new Set(users.map(u => _cohortFromUsername(u.username)).filter(Boolean))].sort((a,b)=>b.localeCompare(a));
  cohortSel.innerHTML = '<option value="">Tất cả khóa</option>';
  cohorts.forEach(c => {
    const o = document.createElement('option');
    o.value = c; o.textContent = `K${c}`;
    cohortSel.appendChild(o);
  });
  // Default: chọn khóa mới nhất (cohorts[0] sau sort desc) để admin không phải cuộn dài
  // qua các khóa cũ. User vẫn chọn được "Tất cả khóa" hoặc khóa cũ qua dropdown.
  if (prevCohort) {
    cohortSel.value = prevCohort;
  } else if (cohorts.length) {
    cohortSel.value = cohorts[0];
  }
  // init open state: mở cohort mới nhất (đầu list đã sort desc), các khóa cũ collapsed
  if (!Object.keys(_svCohortOpen).length && cohorts.length) {
    cohorts.forEach((c, i) => { _svCohortOpen[c] = (i === 0); });
  }
}

