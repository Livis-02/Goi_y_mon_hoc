async function _saveAcademicThresholds() {
  const errEl = document.getElementById('academicThresholdsErr');
  errEl.classList.add('hidden');
  const internship = parseFloat(document.getElementById('ipInternshipTc').value);
  const thesisTc = parseFloat(document.getElementById('ipThesisTc').value);
  const thesisGpa = parseFloat(document.getElementById('ipThesisGpa').value);
  if (!(internship >= 30 && internship <= 250)) { errEl.textContent='Ngưỡng TT DN phải 30–250 TC'; errEl.classList.remove('hidden'); return; }
  if (!(thesisTc >= 30 && thesisTc <= 250)) { errEl.textContent='Ngưỡng ĐATN (TC) phải 30–250'; errEl.classList.remove('hidden'); return; }
  if (!(thesisGpa >= 0 && thesisGpa <= 4)) { errEl.textContent='GPA ĐATN phải 0–4'; errEl.classList.remove('hidden'); return; }
  const payload = {
    internship_min_credits: internship,
    thesis_min_credits: thesisTc,
    thesis_min_gpa4: thesisGpa,
  };
  const res = await callApi('/admin/config/academic-thresholds', {
    method: 'PUT', headers: auth({ 'Content-Type': 'application/json' }),
    body: JSON.stringify(payload),
  });
  if (!res.ok) { errEl.textContent = res.data?.detail || 'Lỗi lưu cấu hình'; errEl.classList.remove('hidden'); return; }
  toast('Đã lưu ngưỡng học vụ');
