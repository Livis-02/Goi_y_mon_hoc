    toast('Đã cập nhật thông tin SV');
    closeEditStudentModal();
    loadUsersTab();  // refresh list
  } catch (e) {
    errEl.textContent = 'Lỗi kết nối: ' + e.message;
    errEl.classList.remove('hidden');
  } finally {
    btn.disabled = false; btn.textContent = 'Lưu thay đổi';
  }
}

function _cohortFromUsername(username) {
  if (!username) return null;
  // Demo format (mới): sv14001 → cohort "14" (sv + 2 số khoá + 3 số STT)
  if (/^sv\d{5}$/i.test(username)) return username.substring(2, 4);
  // Legacy: SV240001 → cohort "24" (SV + 2 số + 4 số)
  if (/^SV\d{6}$/i.test(username)) return username.substring(2, 4);
  // Legacy 10-digit: 2400000001 → cohort "24"
  if (/^\d{10}$/.test(username)) return username.substring(0, 2);
  return null;
}

function applyUsersFilter() {
  const cohort   = document.getElementById('filterCohort')?.value || '';
  const specCode = document.getElementById('filterSpec')?.value || '';
  const status   = document.getElementById('filterStatus')?.value || '';
  const q        = (document.getElementById('userSearchInput')?.value || '').toLowerCase().trim();

  // Convert spec code to full name for comparison
  const specName = _SPEC_CODE_TO_NAME[specCode] || specCode;

  const filtered = _allUsers.filter(u => {
    if (cohort && _cohortFromUsername(u.username) !== cohort) return false;
    if (specCode === '__no_grades__') { if ((u.grade_count||0) > 0) return false; }
    else if (specCode === '__none__') { if (u.specialization) return false; }
    else if (specCode) { if (u.specialization !== specName) return false; }
    if (status === 'changed_pw' && u.default_password) return false;
    if (status === 'default_pw' && !u.default_password) return false;
    // Filter gpa_high/gpa_low đã bỏ ở refactor 2026-05-05 (admin không quản lý điểm)
    if (status === 'overdue' && !u.is_overdue) return false;
    if (status === 'no_grades' && (u.grade_count||0) > 0) return false;
    if (status === 'no_advisor' && u.advisor_id) return false;
    if (q) {
      const hay = ((u.username||'')+' '+(u.full_name||'')).toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  const count = document.getElementById('usersFilterCount');
  if (count) count.textContent = filtered.length < _allUsers.length
    ? `${filtered.length} / ${_allUsers.length} SV` : `${_allUsers.length} SV`;

  // Pagination
  const pageSize = parseInt(document.getElementById('svPageSize')?.value || '20');
  const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
  if (_svPage > totalPages) _svPage = totalPages;
  const start = (_svPage - 1) * pageSize;
  const paged = filtered.slice(start, start + pageSize);

  // Khi đang lọc/search hẹp: auto-mở mọi nhóm SV được render (ngược lại để admin tự mở)
  const narrowing = !!(cohort || specCode || status || q);
  if (narrowing) {
    const cohortsInPage = new Set(paged.map(u => _cohortFromUsername(u.username) || '__other__'));
    cohortsInPage.forEach(c => { _svCohortOpen[c] = true; });
  }

  renderGroupedUsersTable(paged);
  renderSvPagination(filtered.length, pageSize, totalPages);
}

function renderGroupedUsersTable(users) {
  // (Function name giữ để backward-compat — giờ render FLAT table, không group nữa.)
  // User feedback: "bỏ lọc theo dạng list — đã có filter cohort ở trên rồi, list cứ
  //   hiển thị flat, sort khóa mới nhất lên đầu". Tránh phải scroll đến cuối để
  //   mở collapsed group khóa cũ.
  const container = document.getElementById('svGroupedTable');
  const loading   = document.getElementById('usersTableLoading');
  const empty     = document.getElementById('usersTableEmpty');
  loading.classList.add('hidden');
  if (!users.length) {
    container.classList.add('hidden');
    empty.classList.remove('hidden');
    return;
  }
  empty.classList.add('hidden');
  container.classList.remove('hidden');

  // Sort: cohort DESC (K14 → K13 → ... → __other__) THEN username ASC trong cùng cohort.
  // Đảm bảo SV mới vào trường (cohort cao nhất) luôn hiện đầu list.
  const sorted = [...users].sort((a, b) => {
    const ca = _cohortFromUsername(a.username) || '';
    const cb = _cohortFromUsername(b.username) || '';
    if (ca !== cb) {
      if (!ca) return 1;
      if (!cb) return -1;
      return cb.localeCompare(ca);  // DESC
    }
    return (a.username || '').localeCompare(b.username || '');
  });

  // Render single flat table với cohort badge inline trong cột Mã SV
  container.innerHTML = `
    <div class="bg-surface rounded-xl shadow-sm border border-border-subtle overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-surface-subtle/60 border-b border-border-subtle">
              <th class="w-8 px-3 py-2.5">
                <input type="checkbox" autocomplete="off" id="svSelectAllChk"
                  class="w-3.5 h-3.5 rounded accent-blue-600"
                  onclick="_svToggleSelectAll(this)" title="Chọn tất cả"/>
              </th>
              <th class="px-3 py-2.5 text-left text-[11px] font-bold text-text-tertiary uppercase tracking-wider">Mã SV</th>
              <th class="px-3 py-2.5 text-left text-[11px] font-bold text-text-tertiary uppercase tracking-wider">Họ tên</th>
              <th class="px-3 py-2.5 text-left text-[11px] font-bold text-text-tertiary uppercase tracking-wider">Chuyên ngành</th>
              <th class="px-3 py-2.5 text-left text-[11px] font-bold text-text-tertiary uppercase tracking-wider">Cố vấn</th>
              <th class="px-3 py-2.5 text-center text-[11px] font-bold text-text-tertiary uppercase tracking-wider">MK</th>
              <th class="px-3 py-2.5 text-right text-[11px] font-bold text-text-tertiary uppercase tracking-wider w-24">Hành động</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-subtle">
            ${sorted.map(u => _svRowHtml(u)).join('')}
          </tbody>
        </table>
      </div>
    </div>`;
}

