    <button onclick="document.getElementById('_advRowMenu')?.remove();deleteAdvisor(${adv.id}, '${escHtml(adv.username)}')"
      class="w-full flex items-center gap-2 px-3 py-2 text-sm hover:bg-danger-soft text-danger text-left">
      <span class="material-symbols-outlined text-base">delete</span>Xóa cố vấn
    </button>`;
  document.body.appendChild(menu);
  const rect = btn.getBoundingClientRect();
  // Position bên phải button, nếu không đủ chỗ thì đẩy sang trái
  const menuW = 180;
  let left = rect.right - menuW;
  if (left < 8) left = rect.left;
  menu.style.left = left + 'px';
  menu.style.top = (rect.bottom + 4) + 'px';
  // Click ngoài → đóng
  setTimeout(() => {
    document.addEventListener('click', function close(e) {
      if (!menu.contains(e.target)) {
        menu.remove();
        document.removeEventListener('click', close);
      }
    });
  }, 0);
}

function renderAdvisorsList() {
  _renderHeadlessBanner();
  _renderAdvStats();

  // Lần đầu render: nếu user chưa từng chỉnh state, đóng hết section mặc định.
  const allSpecKeys = new Set();
  for (const a of _advisorsList) allSpecKeys.add(a.managed_specialization || '');
  _populateInitialCollapse(allSpecKeys);

  const search = (document.getElementById('advSearchInput')?.value || '').toLowerCase().trim();
  const specFilter = document.getElementById('advFilterSpec')?.value || '';
  const roleFilter = document.getElementById('advFilterRole')?.value || '';

  const filtered = _advisorsList.filter(a => {
    const aSpec = a.managed_specialization || '';
    if (specFilter) {
      if (specFilter === '__none__') { if (aSpec) return false; }
      else if (aSpec !== specFilter) return false;
    }
    if (roleFilter === 'empty' && (a.student_count || 0) > 0) return false;
    if (search) {
      const hay = `${a.teacher_code || ''} ${a.full_name || ''} ${a.username || ''}`.toLowerCase();
      if (!hay.includes(search)) return false;
    }
    return true;
  });

  _renderAdvisors(filtered, !!search);
}

