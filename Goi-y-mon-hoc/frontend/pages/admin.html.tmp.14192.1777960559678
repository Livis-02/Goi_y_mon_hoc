function applyNotifFilter() {
  const q       = (document.getElementById('nfSearchInput')?.value || '').toLowerCase().trim();
  const sev     = document.getElementById('nfFilterSeverity')?.value || '';
  const target  = document.getElementById('nfFilterTarget')?.value || '';
  const dateFil = document.getElementById('nfFilterDate')?.value || '';
  const status  = document.getElementById('nfFilterStatus')?.value || '';

  const now = Date.now();
  const dayMs = 24 * 60 * 60 * 1000;
  const dateLimit = dateFil === 'today' ? now - dayMs
                  : dateFil === 'week'  ? now - 7 * dayMs
                  : dateFil === 'month' ? now - 30 * dayMs
                  : 0;

  const filtered = _nfNotifCache.filter(n => {
    if (sev && n.severity !== sev) return false;
    if (target && n.target_type !== target) return false;
    if (status === 'active' && !n.is_active) return false;
    if (status === 'withdrawn' && n.is_active) return false;
    if (dateLimit && new Date(n.created_at).getTime() < dateLimit) return false;
    if (q) {
      const hay = ((n.title||'') + ' ' + (n.body||'')).toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  const cnt = document.getElementById('nfFilterCount');
  if (cnt) cnt.textContent = filtered.length < _nfNotifCache.length
    ? `${filtered.length} / ${_nfNotifCache.length}` : `${_nfNotifCache.length} thông báo`;

  const pageSize = parseInt(document.getElementById('nfPageSize')?.value || '20');
  const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
  if (_nfPage > totalPages) _nfPage = totalPages;
  if (_nfPage < 1) _nfPage = 1;
  const start = (_nfPage - 1) * pageSize;
  const paged = filtered.slice(start, start + pageSize);

  _renderNotifTable(paged);
  _renderNfPagination(filtered.length, pageSize, totalPages);
}

function _renderNotifTable(rows) {
  const tbody = document.getElementById('notifTableBody');
  if (!rows.length) {
    tbody.innerHTML = `<tr><td colspan="6" class="px-5 py-12 text-sm text-text-tertiary text-center">
      <span class="material-symbols-outlined text-3xl text-text-tertiary block mb-1">inbox</span>
      ${_nfNotifCache.length === 0 ? 'Chưa có thông báo nào.' : 'Không có thông báo phù hợp bộ lọc.'}
