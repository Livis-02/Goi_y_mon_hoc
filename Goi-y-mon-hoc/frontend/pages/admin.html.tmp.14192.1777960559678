  // Auto-select GVCN hoặc người đầu tiên
  const radios = modal.querySelectorAll('input[name="advTransferTo"]');
  if (radios.length) radios[0].checked = true;
}

async function _submitTransferDelete(advisorId, username) {
  const sel = document.querySelector('input[name="advTransferTo"]:checked');
  const errEl = document.getElementById('advTransferErr');
  if (!sel) {
    if (errEl) {
      errEl.textContent = 'Vui lòng chọn cố vấn kế nhiệm';
      errEl.classList.remove('hidden');
    }
    return;
  }
  const transferTo = parseInt(sel.value);
  const res = await callApi(`/admin/advisors/${advisorId}?transfer_to=${transferTo}`, {
    method: 'DELETE', headers: auth(),
  });
  if (res.ok) {
    document.getElementById('advTransferDelModal')?.remove();
    toast(res.data.message || 'Đã xóa cố vấn ' + username, true, 5000);
    if (_activeAdvisorId === advisorId) closeAssignPanel();
    loadAdvisorsList();
  } else {
    if (errEl) {
      errEl.textContent = res.data?.detail || 'Lỗi xóa cố vấn';
      errEl.classList.remove('hidden');
    } else {
      toast(res.data?.detail || 'Lỗi xóa cố vấn', false);
    }
  }
}

