function _injectAdminSidebar() {
  const mount = document.getElementById('adminSidebarMount');
  if (mount && !mount.firstElementChild) mount.innerHTML = _ADMIN_SIDEBAR_HTML;
}

function initAdminSidebarUser(user) {
  const name = user.full_name || user.username || 'Admin';
  const initials = name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
  const nameEl = document.getElementById('adminSidebarName');
  const avatarEl = document.getElementById('adminSidebarAvatar');
  if (nameEl) nameEl.textContent = name;
  if (avatarEl) avatarEl.textContent = initials;
  document.getElementById('adminSidebarLogoutBtn')?.addEventListener('click', () => {
    localStorage.removeItem('access_token');
    window.location.replace('index.html');
  });
  document.getElementById('adminSidebarOverlay')?.addEventListener('click', closeAdminSidebar);
}

function toggleAdminSidebar() {
  const el = document.getElementById('adminSidebar');
  const ov = document.getElementById('adminSidebarOverlay');
  if (!el) return;
  const hidden = el.classList.toggle('-translate-x-full');
  if (ov) ov.classList.toggle('hidden', hidden);
}

function closeAdminSidebar() {
  document.getElementById('adminSidebar')?.classList.add('-translate-x-full');
  document.getElementById('adminSidebarOverlay')?.classList.add('hidden');
}

function setAdminNavActive(tab) {
  document.querySelectorAll('.admin-nav-btn').forEach(btn => {
    btn.classList.toggle('active', btn.id === `adminTabBtn-${tab}`);
  });
}

// ── Init ─────────────────────────────────────────────────────────────────────
(async function initAdmin() {
  if (!token) { window.location.replace('index.html'); return; }
  await _injectAdminSidebar();
  const res = await callApi('/auth/me', { headers: auth() });
  if (!res.ok || (res.data.role !== 'admin')) {
    window.location.replace('index.html');
    return;
  }
  initAdminSidebarUser(res.data);
  switchAdminTab('dashboard');
})();

// ── Course tab state ─────────────────────────────────────────────────────────
let _crsSpec = 'all';
let _crsSubTab = 'list';
let _crsGroupOpen = { compulsory: true, a: false, b: false, c: false };
let _crsDataCache = {};
let _crsSearchTimer;
let _crsPlanChart = null;
let _listPrereqDropClose = null;
const _CRS_SPECS = ['all','7480201_07','7480201_06','7480201_05','7480201_09','7480201_04','7480201_08'];
const _CRS_SPEC_LABEL = {
  'all':'Tất cả CTĐT','7480201_07':'KHMT','7480201_06':'MMT',
  '7480201_05':'CNPM','7480201_09':'HTTT','7480201_04':'THKT','7480201_08':'CNTTDH'
};

async function loadCourses() {
  _crsDataCache = {};
  const res = await callApi('/admin/courses', { headers: auth() });
  if (res.ok) {
    const all = res.data || [];
    document.getElementById('statTotal').textContent = all.length;
    document.getElementById('statSharedCourses').textContent = all.filter(c => !c.required_specialization).length;
    document.getElementById('statSpecCourses').textContent = all.filter(c => !!c.required_specialization).length;
    document.getElementById('statNoTcCourses').textContent = all.filter(c => !c.count_toward_credits).length;
  }
  await loadCrsForSpec(_crsSpec, true);
}

function switchCrsSpec(spec) {
  _crsSpec = spec;
  // Sync dropdown filter
  const sel = document.getElementById('crsFilterSpec');
  if (sel && sel.value !== spec) sel.value = spec;

  // Sub-tab "Kế hoạch chuẩn" chỉ hợp lệ khi chọn 1 CN cụ thể
  const planValid = spec !== 'all' && spec !== 'common';
  const planBtn = document.getElementById('crsSubTab-plan');
  if (planBtn) {
    planBtn.classList.toggle('opacity-40', !planValid);
    planBtn.classList.toggle('cursor-not-allowed', !planValid);
    planBtn.title = planValid ? '' : 'Chọn 1 chuyên ngành cụ thể để xem kế hoạch chuẩn';
  }
  if (!planValid && _crsSubTab === 'plan') {
    switchCrsSubTab('list');
    return;
  }
  if (_crsSubTab === 'plan') {
    loadCrsPlan(spec);
  } else {
    loadCrsForSpec(spec);
  }
}

function switchCrsSubTab(subTab) {
  // Plan view yêu cầu 1 CN cụ thể — tự chọn KHMT (CN đầu tiên) nếu đang ở "all"/"common"
  if (subTab === 'plan' && (_crsSpec === 'all' || _crsSpec === 'common')) {
    _crsSpec = '7480201_07'; // KHMT — CN đầu tiên trong _CRS_SPECS
    const sel = document.getElementById('crsFilterSpec');
    if (sel) sel.value = _crsSpec;
    const planBtn = document.getElementById('crsSubTab-plan');
    if (planBtn) {
      planBtn.classList.remove('opacity-40', 'cursor-not-allowed');
      planBtn.title = '';
    }
  }
  _crsSubTab = subTab;
  ['list','plan'].forEach(t => {
    const btn = document.getElementById('crsSubTab-' + t);
    if (!btn) return;
    const isActive = t === subTab;
    btn.classList.toggle('text-primary', isActive);
    btn.classList.toggle('border-primary', isActive);
    btn.classList.toggle('text-text-tertiary', !isActive);
    btn.classList.toggle('border-transparent', !isActive);
  });
  if (subTab === 'list') {
    document.getElementById('crsPlanView')?.classList.add('hidden');
    if (_crsDataCache[_crsSpec]) {
      document.getElementById('crsLoading')?.classList.add('hidden');
      applyCrsFilter();
    } else {
      loadCrsForSpec(_crsSpec);
    }
  } else {
    document.getElementById('crsListView')?.classList.add('hidden');
    document.getElementById('crsEmpty')?.classList.add('hidden');
    document.getElementById('crsPlanView')?.classList.remove('hidden');
    loadCrsPlan(_crsSpec);
  }
}

async function loadCrsForSpec(spec, force) {
  if (_crsSubTab !== 'list') return;
  const loadEl = document.getElementById('crsLoading');
  const listEl = document.getElementById('crsListView');
  const emptyEl = document.getElementById('crsEmpty');
  loadEl?.classList.remove('hidden');
  listEl?.classList.add('hidden');
  emptyEl?.classList.add('hidden');

  if (!force && _crsDataCache[spec]) {
    loadEl?.classList.add('hidden');
    applyCrsFilter();
    return;
  }
  const url = spec === 'all'
    ? '/admin/courses/all-ctdt'
    : '/admin/courses/grouped?spec=' + encodeURIComponent(spec);
  const res = await callApi(url, { headers: auth() });
  loadEl?.classList.add('hidden');
  if (!res.ok) { toast(extractError(res.data), false); return; }
  _crsDataCache[spec] = res.data;
  applyCrsFilter();
}

function applyCrsFilter() {
  const data = _crsDataCache[_crsSpec];
  if (!data) return;
  const search = (document.getElementById('crsSearchInput')?.value || '').toLowerCase().trim();
  const hkFilter = document.getElementById('crsFilterHk')?.value || '';
  const sortBy = document.getElementById('crsFilterSort')?.value || 'hk';

  function flt(arr) {
    let r = arr.slice();
    if (search) r = r.filter(c => (c.course_code + ' ' + c.course_name).toLowerCase().includes(search));
    if (hkFilter) r = r.filter(c => String(c.typical_semester || '') === hkFilter);
    if (sortBy === 'code')    r.sort((a,b) => a.course_code.localeCompare(b.course_code));
    else if (sortBy === 'credits') r.sort((a,b) => (b.credits||0) - (a.credits||0));
    else r.sort((a,b) => (a.typical_semester||99) - (b.typical_semester||99) || a.course_code.localeCompare(b.course_code));
    return r;
  }
  const comp = flt(data.compulsory || []);
  const ea   = flt(data.elective_a?.courses || []);
  const eb   = flt(data.elective_b?.courses || []);
  const ec   = flt(data.elective_c?.courses || []);
  const total = comp.length + ea.length + eb.length + ec.length;
  const totalAll = (data.compulsory?.length||0) + (data.elective_a?.courses?.length||0) +
                   (data.elective_b?.courses?.length||0) + (data.elective_c?.courses?.length||0);

  const cntEl = document.getElementById('crsFilterCount');
  if (cntEl) cntEl.textContent = total !== totalAll ? `${total} / ${totalAll} môn` : `${totalAll} môn`;

  if (total === 0) {
    document.getElementById('crsListView')?.classList.add('hidden');
    document.getElementById('crsEmpty')?.classList.remove('hidden');
    return;
  }
  document.getElementById('crsEmpty')?.classList.add('hidden');
  document.getElementById('crsListView')?.classList.remove('hidden');

  const isAll = _crsSpec === 'all';
  document.getElementById('crsGroupCompulsory').innerHTML =
    _crsAccordionHtml(isAll ? 'Bắt buộc' : 'Môn bắt buộc', comp, 'compulsory', 0, false);
  document.getElementById('crsGroupA').innerHTML =
    _crsAccordionHtml('Tự chọn A', ea, 'a', data.elective_a?.min_credits||0, false);
  document.getElementById('crsGroupB').innerHTML =
    _crsAccordionHtml('Tự chọn B', eb, 'b', data.elective_b?.min_credits||0, false);
  document.getElementById('crsGroupC').innerHTML =
    _crsAccordionHtml('Tự chọn C', ec, 'c', data.elective_c?.min_credits||0, false);
}

function _crsAccordionHtml(title, courses, group, minCredits, hideIfEmpty) {
  if (hideIfEmpty && !courses.length) return '';
  const isOpen = _crsGroupOpen[group] !== undefined ? _crsGroupOpen[group] : (group === 'compulsory' || group === 'a');
  const tc = courses.reduce((s,c) => s + (parseFloat(c.credits)||0), 0);
  const tcStr = tc % 1 === 0 ? tc.toFixed(0) : tc.toFixed(1);
  const minNote = minCredits > 0 ? ` <span class="text-xs text-warning font-semibold">(min ${minCredits} TC)</span>` : '';
  // Click row môn → mở side panel chi tiết (edit mọi field trong panel).
  // Inline ở table chỉ giữ "Tính TC" toggle (1 click hot action).
  const inner = courses.length === 0
    ? `<div class="px-6 py-5 text-sm text-text-tertiary italic text-center">Không có môn nào trong nhóm này.</div>`
    : `<table class="w-full text-sm">
        <thead class="border-b border-border-subtle bg-surface-subtle/50"><tr>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-text-tertiary uppercase tracking-wider w-24">Mã môn</th>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-text-tertiary uppercase tracking-wider">Tên môn học</th>
          <th class="px-3 py-2 text-center text-[10px] font-bold text-text-tertiary uppercase tracking-wider w-10">TC</th>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-text-tertiary uppercase tracking-wider w-32">CN áp dụng</th>
          <th class="px-3 py-2 text-center text-[10px] font-bold text-text-tertiary uppercase tracking-wider w-20">HK</th>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-text-tertiary uppercase tracking-wider">Tiên quyết</th>
          <th class="px-3 py-2 text-center text-[10px] font-bold text-accent uppercase tracking-wider w-16" title="Click để bật/tắt nhanh">Tính TC</th>
          <th class="px-3 py-2 text-center text-[10px] font-bold text-text-tertiary uppercase tracking-wider w-16">Rating</th>
          <th class="px-3 py-2 text-right text-[10px] font-bold text-text-tertiary uppercase tracking-wider w-12"></th>
        </tr></thead>
        <tbody class="divide-y divide-border-subtle">${courses.map(c => _crsRowHtml(c, group)).join('')}</tbody>
      </table>`;
  return `<div class="bg-surface rounded-xl shadow-sm border border-border-subtle overflow-hidden">
    <button onclick="toggleCrsGroup('${group}')" class="w-full px-4 py-3 flex items-center gap-3 text-left hover:bg-surface-subtle transition-colors">
      <span class="material-symbols-outlined text-text-tertiary text-base transition-transform${isOpen ? ' rotate-90' : ''}" id="crs-chevron-${group}">chevron_right</span>
      <span class="font-bold text-sm text-text-primary flex-1">${escHtml(title)}${minNote}</span>
      <span class="text-xs text-text-tertiary">${courses.length} môn · ${tcStr} TC</span>
    </button>
    <div id="crs-group-${group}" class="${isOpen ? '' : 'hidden'}">${inner}</div>
  </div>`;
}

function toggleCrsGroup(group) {
  _crsGroupOpen[group] = !(_crsGroupOpen[group] !== undefined ? _crsGroupOpen[group] : (group === 'compulsory' || group === 'a'));
  document.getElementById('crs-group-' + group)?.classList.toggle('hidden', !_crsGroupOpen[group]);
  document.getElementById('crs-chevron-' + group)?.classList.toggle('rotate-90', !!_crsGroupOpen[group]);
}

const _HK_CLR = ['','bg-accent-soft text-indigo-700','bg-accent-soft text-indigo-700','bg-accent-soft text-violet-700','bg-accent-soft text-violet-700','bg-success-soft text-success','bg-success-soft text-success','bg-warning-soft text-warning','bg-warning-soft text-warning','bg-orange-100 text-orange-700'];

function _crsPrereqName(code) {
  const data = _crsDataCache[_crsSpec];
  if (!data) return code;
  for (const arr of [data.compulsory, data.elective_a?.courses, data.elective_b?.courses, data.elective_c?.courses]) {
    const c = arr?.find(x => x.course_code === code);
    if (c) return c.course_name;
  }
  return code;
}

function _crsRowHtml(c, group) {
  // JSON.stringify() trả về chuỗi có double quotes (vd "7080206").
  // Khi nhúng vào onclick="..." (cũng dùng double quotes), HTML parser kết thúc
  // attribute tại cặp quote bên trong → "Unexpected end of input".
  // Fix: escape " → &quot; để HTML parser thấy 1 string nguyên vẹn.
  const sc = JSON.stringify(c.course_code).replace(/"/g, '&quot;');
  const sid = JSON.stringify(c.id);  // số → không có quote
  const sname = JSON.stringify(c.course_name).replace(/"/g, '&quot;');

  // CN badges (read-only — lớp 2)
  const specs = (c.specializations && c.specializations.length) ? c.specializations
              : (c.required_specialization ? [c.required_specialization] : []);
  const specBadges = specs.length === 0
    ? '<span class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-surface-strong text-text-tertiary">Chung</span>'
    : specs.map(s => {
        const lbl = (_CRS_SPEC_LABEL[s] || s).split('—')[0].trim();
        return `<span class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-accent-soft text-indigo-700 border border-indigo-100">${escHtml(lbl)}</span>`;
      }).join(' ');

  // HK chip — read-only display (edit qua side panel)
  const _hkVal = c.typical_semester ? parseInt(c.typical_semester) : 0;
  const _hkChipClr = _hkVal > 0 ? (_HK_CLR[_hkVal] || 'bg-surface-strong text-text-tertiary') : 'bg-surface-strong text-text-tertiary';
  const _hkChipText = _hkVal > 0 ? `HK ${_hkVal}` : '—';
  const hkSel = `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold ${_hkChipClr}">${_hkChipText}</span>`;

  // Prereq tags — read-only display (edit qua side panel)
  const prereqTags = (c.prereqs || []).slice(0, 3).map(p => {
    const pName = _crsPrereqName(p);
    return `<span class="inline-flex items-center px-1.5 py-0.5 bg-accent-soft border border-accent-soft-hi text-[10px] rounded" title="${escHtml(p)} — ${escHtml(pName)}">
      <span class="text-accent font-medium max-w-[120px] truncate">${escHtml(pName)}</span>
    </span>`;
  }).join(' ');
  const moreCount = Math.max(0, (c.prereqs || []).length - 3);
  const moreTag = moreCount > 0 ? `<span class="text-[10px] text-text-tertiary">+${moreCount}</span>` : '';
  const noPrereq = (c.prereqs || []).length === 0
    ? '<span class="text-[10px] text-text-tertiary italic">Không</span>'
    : '';

  // Flag tính TC inline toggle (HOT ACTION — giữ inline để click 1 phát)
  const tcToggle = c.count_toward_credits
    ? `<button onclick="event.stopPropagation();toggleCourseCredit(${c.id},false)" title="Đang tính TC. Click để chuyển sang KHÔNG tính TC"
        class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-success-soft text-success border border-emerald-200 hover:bg-success-soft transition-colors">✓ TC</button>`
    : `<button onclick="event.stopPropagation();toggleCourseCredit(${c.id},true)" title="Không tính TC. Click để bật"
        class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-warning-soft text-warning border border-amber-200 hover:bg-warning-soft transition-colors">✗ TC</button>`;

  // Kebab "Tác vụ nâng cao" — chứa Delete (risky action — ưu tiên Re-import CTĐT)
  // Menu fixed-positioned via JS để tránh bị clip bởi overflow-hidden của table card.
  const moreBtn = `<div class="relative inline-block">
    <button onclick="event.stopPropagation();_toggleCrsRowMore(${c.id}, this)"
      title="Tác vụ nâng cao"
      class="p-1 text-text-tertiary hover:text-text-secondary hover:bg-surface-strong rounded transition-colors">
      <span class="material-symbols-outlined text-base">more_vert</span>
    </button>
    <div id="crs-more-${c.id}" class="hidden fixed bg-surface border border-border-default rounded-xl shadow-2xl py-1 w-56 text-left" style="z-index:1000">
      <p class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-text-tertiary">Tác vụ nâng cao</p>
      <button onclick="event.stopPropagation();_closeCrsRowMore();deleteCourse(${sid},${sname})"
        class="w-full text-left px-3 py-2 text-sm text-danger hover:bg-danger-soft flex items-start gap-2">
        <span class="material-symbols-outlined text-base mt-0.5 flex-shrink-0">delete</span>
        <div class="min-w-0">
          <p class="font-semibold leading-tight">Xóa môn lẻ</p>
          <p class="text-[10px] text-text-tertiary leading-tight mt-0.5 whitespace-normal">Khuyến nghị: Re-import CTĐT thay vì xóa từng môn</p>
        </div>
      </button>
    </div>
  </div>`;

  // Rating badge (read-only — SV mới rate được)
  const avgR = c.avg_rating;
  const cntR = c.rating_count || 0;
  const ratingBadge = avgR != null
    ? `<div class="inline-flex flex-col items-center gap-0" title="${cntR} đánh giá">
        <div class="flex items-center gap-0.5">
          <span class="text-amber-400 text-xs">★</span>
          <span class="text-xs font-bold text-warning">${avgR.toFixed(1)}</span>
        </div>
        <span class="text-[9px] text-text-tertiary">${cntR} SV</span>
      </div>`
    : `<span class="text-[10px] text-text-tertiary italic">—</span>`;

  // Edit button — chỉ sửa mô tả + kỹ năng (theo philosophy "source of truth =
  // trường" — không sửa tên/TC/CN/HK/prereq). Icon edit_note + label "Sửa"
  // ngắn gọn, tooltip nói rõ chỉ sửa mô tả+kỹ năng.
  const editBtn = `<button onclick="event.stopPropagation();openCourseSidePanel(${sc})"
    title="Sửa mô tả + kỹ năng môn này dạy (hiển thị cho SV trong roadmap)"
    class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-accent-soft hover:bg-accent-soft-hi text-accent text-[11px] font-semibold transition-colors whitespace-nowrap">
    <span class="material-symbols-outlined msym text-[14px]">edit_note</span>
    <span class="hidden lg:inline">Sửa</span>
  </button>`;

  // Click row → mở side panel + có affordance rõ ràng (cursor + edit icon).
  // Hover state đậm hơn (+ ring) để feedback cho user.
  return `<tr class="hover:bg-accent-soft hover:ring-1 hover:ring-accent-soft-hi transition-colors cursor-pointer group" onclick="openCourseSidePanel(${sc})"
    title="Click để xem & chỉnh sửa môn">
    <td class="px-3 py-2"><span class="font-mono text-xs font-bold text-accent">${escHtml(c.course_code)}</span></td>
    <td class="px-3 py-2 text-sm text-text-primary">${escHtml(c.course_name)}</td>
    <td class="px-3 py-2 text-center text-xs font-bold text-text-secondary">${c.credits != null ? c.credits : '—'}</td>
    <td class="px-3 py-2"><div class="flex flex-wrap gap-0.5">${specBadges}</div></td>
    <td class="px-3 py-2 text-center">${hkSel}</td>
    <td class="px-3 py-2"><div class="flex flex-wrap items-center gap-1">${prereqTags}${moreTag}${noPrereq}</div></td>
    <td class="px-3 py-2 text-center">${tcToggle}</td>
    <td class="px-3 py-2 text-center">${ratingBadge}</td>
    <td class="px-3 py-2 text-right">
      <div class="flex items-center justify-end gap-1">
        ${editBtn}
        ${moreBtn}
      </div>
    </td>
  </tr>`;
}

// Kebab "Tác vụ nâng cao" trên row môn (chứa Delete)
// Menu dùng position:fixed → escape khỏi overflow:hidden của table card.
// Tính position từ btn rect: top = btn.bottom + 4px, left = btn.right - menuWidth.
// Auto-flip lên trên nếu sát đáy viewport.
function _toggleCrsRowMore(id, btn) {
  const menu = document.getElementById('crs-more-' + id);
  if (!menu) return;
  const wasHidden = menu.classList.contains('hidden');
  document.querySelectorAll('[id^="crs-more-"]').forEach(m => m.classList.add('hidden'));
  if (!wasHidden) return;

  // Show + compute fixed position
  menu.classList.remove('hidden');
  const rect = btn.getBoundingClientRect();
  const menuW = 224;  // w-56
  const menuH = menu.offsetHeight || 80;
  const margin = 8;
  let top  = rect.bottom + 4;
  let left = rect.right  - menuW;  // align right edge với button
  // Auto-flip up nếu menu vượt đáy viewport
  if (top + menuH + margin > window.innerHeight) {
    top = rect.top - menuH - 4;
  }
  // Đừng để menu chạy ra khỏi mép trái
  if (left < margin) left = margin;
  menu.style.top  = top + 'px';
  menu.style.left = left + 'px';
}
function _closeCrsRowMore() {
  document.querySelectorAll('[id^="crs-more-"]').forEach(m => m.classList.add('hidden'));
}
// Đóng menu khi scroll/resize (vì position fixed cần re-compute)
window.addEventListener('scroll', _closeCrsRowMore, true);
window.addEventListener('resize', _closeCrsRowMore);
document.addEventListener('click', (e) => {
  if (!e.target.closest('[id^="crs-more-"]') && !e.target.closest('button[onclick*="_toggleCrsRowMore"]')) {
    _closeCrsRowMore();
  }
});

function toggleCrsMenu(code, btn) {
  const menu = document.getElementById('crs-menu-' + code);
  if (!menu) return;
  const wasHidden = menu.classList.contains('hidden');
  document.querySelectorAll('[id^="crs-menu-"]').forEach(m => m.classList.add('hidden'));
  if (wasHidden) menu.classList.remove('hidden');
}


