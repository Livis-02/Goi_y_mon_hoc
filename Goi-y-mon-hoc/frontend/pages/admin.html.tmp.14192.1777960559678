// ── Save ──────────────────────────────────────────────────────────────────
async function _crsSavePanel() {
  if (!_crsPanelDirty || !_crsPanelDraft) return;
  const orig = _crsPanelOriginal;
  const d = _crsPanelDraft;

  // Theo philosophy "EduGuide chỉ mirror CTDT từ trường", admin chỉ sửa được
  // description (field skills sửa qua modal riêng). Các field khác (tên/TC/CN/HK)
  // luôn giữ nguyên giá trị gốc — không cảnh báo critical change vì UI không
  // cho user đổi chúng.

  const saveBtn = document.getElementById('crsPanelBtnSave');
  if (saveBtn) {
    saveBtn.setAttribute('disabled', 'disabled');
    saveBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span>Đang lưu...';
  }

  try {
    // PUT /admin/courses/{id} — gửi nguyên các field từ orig, chỉ swap description
    const body = {
      course_code: orig.course_code,
      course_name: orig.course_name,
      credits: orig.credits,
      description: d.description || null,    // ← field DUY NHẤT thực sự đổi
      count_toward_credits: !!orig.count_toward_credits,
      typical_semester: orig.typical_semester || null,
      specializations: orig.specializations || [],
      required_specialization: orig.required_specialization || null,
    };
    const res = await callApi(`/admin/courses/${_crsPanelCourseId}`, {
      method: 'PUT',
      headers: { ...auth(), 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) {
      throw new Error(res.data?.detail || 'HTTP ' + res.status);
    }

    // Save skills (inline trong panel — _skillsSelected sync với inline edits)
    if (_skillsCurrentCourse === orig.course_code) {
      const skills = Object.entries(_skillsSelected).map(([code, weight]) => ({
        skill_code: code, weight: weight,
      }));
      const skillsRes = await callApi(`/admin/courses/${encodeURIComponent(orig.course_code)}/skills`, {
        method: 'PUT', headers: { ...auth(), 'Content-Type': 'application/json' },
        body: JSON.stringify({ skills }),
      });
      if (!skillsRes.ok) {
        console.warn('[crs] Save skills failed:', skillsRes.data);
        toast('Lưu mô tả OK nhưng lưu kỹ năng lỗi: ' + (extractError(skillsRes.data) || 'unknown'), false);
      }
    }

    // Prereqs: theo philosophy đã không cho admin sửa qua UI nữa, nên skip diff
    const newPrereqs = (d.prereqs || []).slice().sort();

    toast('Đã lưu thay đổi', 'success');
    // Reload data + re-open panel với data mới
    _crsPanelOriginal = JSON.parse(JSON.stringify(d));
    _crsPanelOriginal.prereqs = newPrereqs;
    _crsPanelDirty = false;
    _crsUpdateDirtyUI();

    // Reload bảng (và update local cache)
    await loadCoursesData();
  } catch (e) {
    toast('Lưu thất bại: ' + e.message, 'error');
    if (saveBtn) {
      saveBtn.removeAttribute('disabled');
      saveBtn.innerHTML = oldHtml;
    }
  }
}
window._crsSavePanel = _crsSavePanel;

