let _lgCache = [];
let _lgPage = 1;

async function loadLogsTab() {
  _loadGradThreshold();
  _loadAcademicThresholds();
  document.getElementById('logsLoading').classList.remove('hidden');
  document.getElementById('logsTable').classList.add('hidden');
  document.getElementById('logsEmpty').classList.add('hidden');

  const res = await callApi('/admin/logs?limit=1000', { headers: auth() });
  document.getElementById('logsLoading').classList.add('hidden');

  if (!res.ok || !Array.isArray(res.data)) {
    _lgCache = [];
    document.getElementById('logsEmpty').textContent = 'Lỗi tải nhật ký.';
    document.getElementById('logsEmpty').classList.remove('hidden');
    return;
  }
  _lgCache = res.data;

  // Populate filter selects from cache
  const actionSel = document.getElementById('lgFilterAction');
  const adminSel  = document.getElementById('lgFilterAdmin');
  if (actionSel) {
    const prev = actionSel.value;
    const actions = [...new Set(_lgCache.map(l => l.action).filter(Boolean))].sort();
    actionSel.innerHTML = '<option value="">Mọi hành động</option>' + actions.map(a => {
      const lbl = (ACTION_LABELS[a] && ACTION_LABELS[a].label) || a;
      return `<option value="${escHtml(a)}">${escHtml(lbl)}</option>`;
    }).join('');
    if (prev) actionSel.value = prev;
  }
  if (adminSel) {
    const prev = adminSel.value;
    const admins = [...new Set(_lgCache.map(l => l.admin_username).filter(Boolean))].sort();
    adminSel.innerHTML = '<option value="">Mọi admin</option>' + admins.map(a =>
      `<option value="${escHtml(a)}">${escHtml(a)}</option>`).join('');
    if (prev) adminSel.value = prev;
  }

  applyLogsFilter();
}

function applyLogsFilter() {
  const q       = (document.getElementById('lgSearchInput')?.value || '').toLowerCase().trim();
  const action  = document.getElementById('lgFilterAction')?.value || '';
  const admin   = document.getElementById('lgFilterAdmin')?.value || '';
  const dateFil = document.getElementById('lgFilterDate')?.value || '';

  const now = Date.now();
  const dayMs = 24 * 60 * 60 * 1000;
  const dateLimit = dateFil === 'today' ? now - dayMs
                  : dateFil === 'week'  ? now - 7 * dayMs
                  : dateFil === 'month' ? now - 30 * dayMs
                  : 0;

  const filtered = _lgCache.filter(log => {
    if (action && log.action !== action) return false;
    if (admin && log.admin_username !== admin) return false;
    if (dateLimit && new Date(log.created_at).getTime() < dateLimit) return false;
    if (q) {
      const hay = `${log.admin_username||''} ${log.action||''} ${log.target_id||''} ${log.detail||''}`.toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  const cnt = document.getElementById('lgFilterCount');
  if (cnt) cnt.textContent = filtered.length < _lgCache.length
    ? `${filtered.length} / ${_lgCache.length}` : `${_lgCache.length} dòng`;

  const empty = document.getElementById('logsEmpty');
  const table = document.getElementById('logsTable');
  if (!filtered.length) {
    empty.textContent = _lgCache.length === 0 ? 'Chưa có nhật ký nào.' : 'Không có dòng phù hợp bộ lọc.';
    empty.classList.remove('hidden');
    table.classList.add('hidden');
    document.getElementById('lgPagination').classList.add('hidden');
    return;
  }
  empty.classList.add('hidden');
  table.classList.remove('hidden');

  const pageSize = parseInt(document.getElementById('lgPageSize')?.value || '50');
  const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
  if (_lgPage > totalPages) _lgPage = totalPages;
  if (_lgPage < 1) _lgPage = 1;
  const start = (_lgPage - 1) * pageSize;
  const paged = filtered.slice(start, start + pageSize);

  const tbody = document.getElementById('logsBody');
  tbody.innerHTML = paged.map(log => {
    const act = ACTION_LABELS[log.action] || { label: log.action, color: 'bg-surface-strong text-text-secondary' };
    const dt = new Date(log.created_at).toLocaleString('vi-VN');
    const detail = log.detail
      ? `<span class="text-text-tertiary text-[11px]" title="${escHtml(log.detail)}">${escHtml(log.detail.length > 60 ? log.detail.slice(0, 60) + '…' : log.detail)}</span>`
      : '—';
    return `<tr class="hover:bg-surface-subtle/50 transition-colors">
      <td class="px-4 py-3 text-xs text-text-tertiary whitespace-nowrap">${dt}</td>
      <td class="px-4 py-3 text-xs font-mono font-bold">${escHtml(log.admin_username || '—')}</td>
      <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full text-[11px] font-bold ${act.color}">${escHtml(act.label)}</span></td>
      <td class="px-4 py-3 text-xs font-mono">${escHtml(String(log.target_id || '—'))}</td>
      <td class="px-4 py-3">${detail}</td>
    </tr>`;
  }).join('');

  _renderLgPagination(filtered.length, pageSize, totalPages);
}

function _renderLgPagination(total, pageSize, totalPages) {
  const wrap = document.getElementById('lgPagination');
  if (!wrap) return;
  if (total <= pageSize) { wrap.classList.add('hidden'); return; }
  wrap.classList.remove('hidden');
  const ctrl = document.getElementById('lgPageControls');
  const range = (a,b) => { const r=[]; for (let i=a;i<=b;i++) r.push(i); return r; };
  const btnCls = (active) => `px-2.5 py-1 rounded-md font-semibold transition-colors ${active ? 'bg-indigo-600 text-white' : 'bg-surface-subtle text-text-secondary hover:bg-surface-strong'}`;
  let html = `<button onclick="_lgPage=Math.max(1,_lgPage-1);applyLogsFilter()" ${_lgPage===1?'disabled':''} class="${btnCls(false)}">&#8249;</button>`;
  let pages;
  if (totalPages <= 7) pages = range(1, totalPages);
  else if (_lgPage <= 4) pages = [...range(1,5), -1, totalPages];
  else if (_lgPage >= totalPages-3) pages = [1, -1, ...range(totalPages-4, totalPages)];
  else pages = [1, -1, ...[_lgPage-1,_lgPage,_lgPage+1], -1, totalPages];
  for (const p of pages) {
    if (p === -1) html += `<span class="px-1 text-text-tertiary">…</span>`;
    else html += `<button onclick="_lgPage=${p};applyLogsFilter()" class="${btnCls(p===_lgPage)}">${p}</button>`;
  }
  html += `<button onclick="_lgPage=Math.min(${totalPages},_lgPage+1);applyLogsFilter()" ${_lgPage===totalPages?'disabled':''} class="${btnCls(false)}">&#8250;</button>`;
  ctrl.innerHTML = html;
}

